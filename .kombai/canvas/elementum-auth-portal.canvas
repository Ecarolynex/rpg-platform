      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=EB+Garamond:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n\n:root { --forest-ink:#091713; --deep-panel:#10231f; --panel-edge:#274039; --stone:#596057; --stone-deep:#303831; --iron:#111b19; --iron-line:#65716a; --gold:#c7a66c; --gold-bright:#f0dba2; --parchment:#f4efe9; --dim:#c7c9bd; }\nhtml, body { min-height:100%; }\n.portal-backdrop { min-height:100vh; background:#07100e; font-family:'EB Garamond',Georgia,serif; color:var(--parchment); }\n.portal-photo { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 48%; filter:saturate(.7) brightness(.43); }\n.portal-shade { position:absolute; inset:0; background:linear-gradient(180deg,rgba(4,13,11,.43) 0%,rgba(4,12,11,.66) 58%,rgba(3,10,9,.82) 100%); }\n.portal-stone { position:relative; isolation:isolate; width:min(100%,1040px); margin:0 auto; padding:12px 15px 20px; background:linear-gradient(112deg,#303831 0%,#60645a 23%,#3b433c 47%,#60645a 72%,#303831 100%); clip-path:polygon(50% 0,94% 20%,100% 28%,100% 100%,0 100%,0 28%,6% 20%); }\n.portal-stone::before { content:''; position:absolute; z-index:-1; inset:0; pointer-events:none; opacity:.42; background:linear-gradient(180deg,transparent 0 20%,rgba(22,35,29,.6) 20.2% 20.5%,transparent 20.8%),linear-gradient(180deg,transparent 0 32%,rgba(16,26,22,.55) 32.2% 32.5%,transparent 32.8%),linear-gradient(180deg,transparent 0 56%,rgba(15,26,22,.54) 56.2% 56.5%,transparent 56.8%); }\n.portal-iron { position:relative; min-height:900px; padding:1px; background:linear-gradient(180deg,#202a26,#0c1513 33%,#1c2823); clip-path:polygon(50% 0,94% 20%,100% 28%,100% 100%,0 100%,0 28%,6% 20%); }\n.portal-core { width:82%; max-width:780px; margin:176px auto 0; padding:0 0 0; position:relative; z-index:1; background:#0c1c19; border:1px solid rgba(114,126,111,.62); box-shadow:0 0 0 8px rgba(9,15,13,.45); }\n.portal-core::before { content:''; position:absolute; inset:-7px; border:1px solid rgba(169,151,103,.28); pointer-events:none; }\n.crown { padding:28px 34px 23px; text-align:center; background:#10231f; border-bottom:1px solid rgba(199,166,108,.35); }\n.crown-mark { width:48px; height:52px; flex:none; }\n.crown-title { margin:13px 0 6px; color:var(--gold-bright); font-family:'Cinzel',Georgia,serif; font-size:clamp(1.12rem,2.3vw,1.65rem); line-height:1.25; letter-spacing:.07em; font-weight:600; }\n.crown-subtitle { color:#ddd3bd; font-size:1.08rem; line-height:1.4; }\n.door-tabs { display:grid; grid-template-columns:1fr 1fr; background:#111a18; border-bottom:1px solid rgba(183,166,123,.45); }\n.door-tab { min-height:58px; display:flex; align-items:center; justify-content:center; padding:12px 14px; color:#9ea69d; font-family:'Cinzel',Georgia,serif; font-size:.93rem; font-weight:600; letter-spacing:.11em; border-right:1px solid rgba(175,163,128,.23); background:linear-gradient(180deg,#151e1b,#101715); }\n.door-tab:last-child { border-right:0; }\n.door-tab-active { color:#18140d; background:linear-gradient(180deg,#e0c687,#b8995e); text-shadow:0 1px rgba(255,255,255,.32); box-shadow:inset 0 2px 0 rgba(255,255,255,.28),inset 0 -3px 0 #665336; }\n.form-plane { padding:30px clamp(22px,5vw,54px) 32px; background:#0c1c19; }\n.register-form { display:flex; flex-direction:column; gap:22px; }\n.field { display:flex; flex-direction:column; gap:8px; min-width:0; }\n.field label { color:#ddd2b9; font-family:'Cinzel',Georgia,serif; font-size:.83rem; font-weight:600; letter-spacing:.035em; line-height:1.35; }\n.field input { width:100%; min-height:56px; padding:12px 16px; border:1px solid #59635b; border-radius:3px; background:#071310; color:#f4efe9; font-family:'EB Garamond',Georgia,serif; font-size:1.08rem; box-shadow:inset 0 2px 8px rgba(0,0,0,.34); }\n.field input::placeholder { color:#a6aa9f; font-style:italic; opacity:1; }\n.field input:focus { outline:2px solid #c7a66c; outline-offset:2px; border-color:#f0dba2; }\n.password-pair { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; }\n.register-submit { min-height:62px; display:flex; align-items:center; justify-content:center; padding:12px 22px; margin-top:3px; border:1px solid #9d804b; border-radius:3px; background:linear-gradient(180deg,#e2c987,#c5a666); color:#17130c; text-align:center; font-family:'Cinzel',Georgia,serif; font-size:1rem; line-height:1.35; letter-spacing:.045em; font-weight:700; box-shadow:inset 0 1px 0 rgba(255,255,255,.32),0 3px 0 #51442d; }\n.switch-prompt { margin:0; padding-top:3px; text-align:center; color:#c6c6b9; font-size:1.03rem; line-height:1.5; }\n.switch-prompt span { color:#f0dba2; text-decoration:underline; text-decoration-color:rgba(199,166,108,.75); text-underline-offset:4px; }\n.threshold { width:82%; max-width:780px; min-height:98px; margin:0 auto; display:flex; align-items:center; justify-content:center; gap:clamp(22px,5vw,62px); color:#a9aa9c; background:linear-gradient(180deg,#242b25,#171e1a); border:1px solid rgba(110,118,100,.55); border-top:4px solid #303832; box-shadow:0 7px 0 rgba(0,0,0,.4); }\n.threshold i { display:inline-flex; align-items:center; justify-content:center; width:30px; height:34px; font-size:1.65rem; line-height:1; color:#b4aa8c; }\n.threshold .phoenix-mark { width:32px; height:32px; object-fit:contain; filter:brightness(0) saturate(100%) invert(74%) sepia(15%) saturate(650%) hue-rotate(8deg) brightness(90%) contrast(84%); }\n@media(max-width:700px) {\n  .portal-stone { padding:7px 6px 14px; clip-path:polygon(50% 0,95% 16%,100% 23%,100% 100%,0 100%,0 23%,5% 16%); }\n  .portal-iron { min-height:0; padding-bottom:4px; clip-path:polygon(50% 0,95% 16%,100% 23%,100% 100%,0 100%,0 23%,5% 16%); }\n  .portal-core { width:92%; margin-top:142px; box-shadow:0 0 0 4px rgba(9,15,13,.45); }\n  .crown { padding:22px 15px 19px; }\n  .crown-mark { width:42px; height:46px; }\n  .crown-title { letter-spacing:.035em; }\n  .crown-subtitle { font-size:1rem; }\n  .door-tab { min-height:54px; font-size:.82rem; letter-spacing:.07em; }\n  .form-plane { padding:24px 20px 27px; }\n  .register-form { gap:20px; }\n  .password-pair { grid-template-columns:1fr; gap:20px; }\n  .threshold { width:92%; min-height:78px; gap:clamp(13px,5vw,25px); }\n  .threshold i { font-size:1.45rem; }\n}\n@media(max-width:380px) { .portal-core { width:94%; margin-top:124px; } .form-plane { padding-inline:15px; } .threshold { gap:12px; } }\n</style>\n<main class=\"portal-backdrop relative isolate min-h-screen overflow-x-clip px-3 py-6 sm:px-5 sm:py-8 lg:px-8\" data-kid=\"1\" data-name=\"portal registration page layout\">\n    <img alt=\"Dark forest path beyond a stone portal, photograph by Alexey Demidov on Unsplash\" class=\"portal-photo\" data-kid=\"1-1\" data-name=\"background forest photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1644976914567-d830fcd4fec9?crop=entropy&cs=srgb&fm=jpg&&ixlib=rb-4.1.0&auto=format&w=1800&q=80&fit=crop\"/>\n    <div aria-hidden=\"true\" class=\"portal-shade\" data-kid=\"1-2\" data-name=\"fullscreen darkening shade overlay\">\n    </div>\n    <div class=\"relative z-10 mx-auto max-w-[1200px]\" data-kid=\"1-3\" data-name=\"centered content column\">\n        <section aria-label=\"Portal dos Aventureiros\" class=\"portal-stone\" data-kid=\"1-3-1\" data-name=\"stone portal frame section\">\n            <div class=\"portal-iron\" data-kid=\"1-3-1-1\" data-name=\"iron inner panel\">\n                <article class=\"portal-core\" data-kid=\"1-3-1-1-1\" data-name=\"portal core authentication card\">\n                    <header class=\"crown\" data-kid=\"1-3-1-1-1-1\" data-name=\"card crown header\">\n                        <svg aria-hidden=\"true\" class=\"crown-mark mx-auto\" data-kid=\"1-3-1-1-1-1-1\" data-name=\"shield emblem icon\" fill=\"none\" viewbox=\"0 0 48 52\">\n                            <path d=\"M24 2 44 9v14c0 14-8 22-20 27C12 45 4 37 4 23V9z\" fill=\"rgba(11,19,18,.9)\" stroke=\"#f0dba2\" stroke-width=\"1.8\">\n                            </path>\n                            <path d=\"M24 10v32M14 18h20M15 30h18\" stroke=\"#f0dba2\" stroke-linecap=\"round\" stroke-width=\"1.5\">\n                            </path>\n                            <circle cx=\"24\" cy=\"18\" fill=\"#f0dba2\" r=\"2.5\">\n                            </circle>\n                        </svg>\n                        <h1 class=\"crown-title\" data-kid=\"1-3-1-1-1-1-2\" data-name=\"portal main title\">\n                            PORTAL DOS AVENTUREIROS\n                        </h1>\n                        <p class=\"crown-subtitle\" data-kid=\"1-3-1-1-1-1-3\" data-name=\"portal subtitle text\">\n                            ELEMENTUM — As crónicas começam aqui\n                        </p>\n                    </header>\n                    <div aria-label=\"Autenticação\" class=\"door-tabs\" data-kid=\"1-3-1-1-1-2\" data-name=\"authentication mode tab list\" role=\"tablist\">\n                        <div aria-selected=\"false\" class=\"door-tab\" data-kid=\"1-3-1-1-1-2-1\" data-name=\"sign in tab\" role=\"tab\">\n                            ENTRAR\n                        </div>\n                        <div aria-selected=\"true\" class=\"door-tab door-tab-active\" data-kid=\"1-3-1-1-1-2-2\" data-name=\"create account active tab\" role=\"tab\">\n                            CRIAR CONTA\n                        </div>\n                    </div>\n                    <div class=\"form-plane\" data-kid=\"1-3-1-1-1-3\" data-name=\"registration form panel\">\n                        <form aria-label=\"Criar conta de aventureiro\" class=\"register-form\" data-kid=\"1-3-1-1-1-3-1\" data-name=\"adventurer create account form\">\n                            <div class=\"field\" data-kid=\"1-3-1-1-1-3-1-1\" data-name=\"username field group\">\n                                <label data-kid=\"1-3-1-1-1-3-1-1-1\" data-name=\"username field label\" for=\"reg-usuario\">\n                                    Nome de Aventureiro (Usuário)\n                                </label>\n                                <input autocomplete=\"username\" data-kid=\"1-3-1-1-1-3-1-1-2\" data-name=\"username input field\" id=\"reg-usuario\" placeholder=\"Ex: MagoEldrin, Valquíria...\" required=\"\" type=\"text\"/>\n                            </div>\n                            <div class=\"field\" data-kid=\"1-3-1-1-1-3-1-2\" data-name=\"email field group\">\n                                <label data-kid=\"1-3-1-1-1-3-1-2-1\" data-name=\"email field label\" for=\"reg-email\">\n                                    E-mail do Reino\n                                </label>\n                                <input autocomplete=\"email\" data-kid=\"1-3-1-1-1-3-1-2-2\" data-name=\"email input field\" id=\"reg-email\" placeholder=\"aventureiro@reino.com\" required=\"\" type=\"email\"/>\n                            </div>\n                            <div class=\"password-pair\" data-kid=\"1-3-1-1-1-3-1-3\" data-name=\"password fields row\">\n                                <div class=\"field\" data-kid=\"1-3-1-1-1-3-1-3-1\" data-name=\"password field group\">\n                                    <label data-kid=\"1-3-1-1-1-3-1-3-1-1\" data-name=\"password field label\" for=\"reg-senha\">\n                                        Senha\n                                    </label>\n                                    <input autocomplete=\"new-password\" data-kid=\"1-3-1-1-1-3-1-3-1-2\" data-name=\"password input field\" id=\"reg-senha\" placeholder=\"Mínimo 3 caracteres\" required=\"\" type=\"password\"/>\n                                </div>\n                                <div class=\"field\" data-kid=\"1-3-1-1-1-3-1-3-2\" data-name=\"confirm password field group\">\n                                    <label data-kid=\"1-3-1-1-1-3-1-3-2-1\" data-name=\"confirm password field label\" for=\"reg-confirma-senha\">\n                                        Confirmar Senha\n                                    </label>\n                                    <input autocomplete=\"new-password\" data-kid=\"1-3-1-1-1-3-1-3-2-2\" data-name=\"confirm password input field\" id=\"reg-confirma-senha\" placeholder=\"Repita a senha\" required=\"\" type=\"password\"/>\n                                </div>\n                            </div>\n                            <button class=\"register-submit\" data-kid=\"1-3-1-1-1-3-1-4\" data-name=\"create account submit button\" type=\"button\">\n                                Forjar Conta de Aventureiro\n                            </button>\n                            <p class=\"switch-prompt\" data-kid=\"1-3-1-1-1-3-1-5\" data-name=\"switch to sign-in prompt text\">\n                                Já possui uma lenda registrada?\n                                <span data-kid=\"1-3-1-1-1-3-1-5-1\" data-name=\"existing account sign-in link\">\n                                    Entrar com conta existente\n                                </span>\n                            </p>\n                        </form>\n                    </div>\n                </article>\n                <div aria-hidden=\"true\" class=\"threshold\" data-kid=\"1-3-1-1-2\" data-name=\"decorative threshold bar\">\n                    <i class=\"ti ti-shield-chevron\" data-kid=\"1-3-1-1-2-1\" data-name=\"shield chevron icon\">\n                    </i>\n                    <i class=\"ti ti-moneybag\" data-kid=\"1-3-1-1-2-2\" data-name=\"money bag icon\">\n                    </i>\n                    <img alt=\"\" class=\"phoenix-mark\" data-kid=\"1-3-1-1-2-3\" data-name=\"phoenix winged emblem image\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/winged-emblem.svg\"/>\n                    <i class=\"ti ti-swords\" data-kid=\"1-3-1-1-2-4\" data-name=\"crossed swords icon\">\n                    </i>\n                    <i class=\"ti ti-star\" data-kid=\"1-3-1-1-2-5\" data-name=\"five point star icon\">\n                    </i>\n                </div>\n            </div>\n        </section>\n    </div>\n</main>\n",
      "comments": [],
      "created": "2026-10-11T15:28:38.315597+00:00",
      "modified": "2026-10-11T15:29:40.304884+00:00",
      "id": "var_f348b3f28b5e",
      "contentHeight": 1102
    },
    "var_06e85bff907a": {
      "type": "variant",
      "label": "01 · Intact Gate — Login",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n:root { --forest:#091713; --iron:#101b19; --iron-deep:#081310; --stone:#29352f; --moss:#516044; --gold:#c7a66c; --gold-bright:#f0dba2; --parchment:#f4efe9; --muted:#c2c9bf; --font-title:'Cinzel', Georgia, serif; --font-body:'EB Garamond', Georgia, serif; }\n.gate-frame { position:relative; width:min(100%, 900px); min-height:824px; margin:18px auto 26px; padding:13px; clip-path:polygon(50% 0,56% 1%,63% 4%,70% 9%,78% 16%,87% 26%,95% 37%,100% 44%,100% 100%,0 100%,0 44%,5% 37%,13% 26%,22% 16%,30% 9%,37% 4%,44% 1%); background:linear-gradient(90deg,#4d5a4c 0%,#262f2a 11%,#131d19 22%,#111a17 78%,#2b352e 90%,#59634f 100%); box-shadow:0 0 0 1px rgba(9,16,14,.9), 0 22px 50px rgba(0,0,0,.55); }\n.gate-frame::before { content:''; position:absolute; inset:0; pointer-events:none; background:repeating-linear-gradient(0deg,transparent 0 92px,rgba(7,12,10,.42) 92px 95px,transparent 95px 183px); opacity:.48; }\n.gate-iron { position:relative; min-height:798px; clip-path:polygon(50% 0,56% 1%,63% 4%,70% 9%,78% 16%,87% 26%,95% 37%,100% 44%,100% 100%,0 100%,0 44%,5% 37%,13% 26%,22% 16%,30% 9%,37% 4%,44% 1%); padding:0 0 28px; background:linear-gradient(90deg,#0a1411 0%,#14211b 13%,#111b17 25%,#101a17 75%,#14211b 87%,#091310 100%); border:1px solid rgba(178,165,127,.36); }\n.gate-iron::before { content:''; position:absolute; inset:9px; pointer-events:none; border:1px solid rgba(186,166,119,.37); clip-path:polygon(50% 0,56% 1%,63% 4%,70% 9%,78% 16%,87% 26%,95% 37%,100% 44%,100% 100%,0 100%,0 44%,5% 37%,13% 26%,22% 16%,30% 9%,37% 4%,44% 1%); }\n.gate-content { position:relative; z-index:1; width:min(100% - 72px, 590px); margin:0 auto; padding-top:80px; }\n.gate-header { text-align:center; padding:10px 14px 23px; border-bottom:1px solid rgba(193,177,135,.28); }\n.gate-header h1 { margin:13px 0 5px; font-family:var(--font-title); font-size:clamp(26px,3vw,37px); font-weight:600; letter-spacing:.035em; line-height:1.16; color:var(--gold-bright); }\n.gate-header p { margin:0; color:#e0d4b7; font:500 18px/1.35 var(--font-body); }\n.crest-box { width:50px; height:54px; margin:0 auto; display:grid; place-items:center; border:1px solid rgba(240,219,162,.68); background:#101b18; }\n.tabs { display:grid; grid-template-columns:1fr 1fr; gap:8px; padding:12px 0 0; }\n.tab { min-height:48px; display:grid; place-items:center; font:600 15px/1.2 var(--font-title); letter-spacing:.055em; color:#b8b9a8; border:1px solid rgba(136,143,121,.56); background:linear-gradient(180deg,#39443a,#252f29 48%,#1a241f); box-shadow:inset 0 1px 0 rgba(255,255,255,.07); }\n.tab.active { color:#f3dfa9; background:linear-gradient(180deg,#3c4436,#263128 52%,#1a241f); border-color:rgba(214,184,116,.82); box-shadow:inset 0 2px 0 rgba(240,219,162,.32), inset 0 -2px 0 rgba(8,13,11,.64); }\n.auth-form { padding:24px 0 0; display:flex; flex-direction:column; gap:19px; }\n.field { display:flex; flex-direction:column; gap:8px; }\n.field label { color:#e3dcc9; font:600 15px/1.25 var(--font-title); letter-spacing:.035em; }\n.field input { width:100%; min-height:54px; padding:13px 17px; border:1px solid #69726a; border-radius:2px; background:linear-gradient(180deg,#0a1311,#0d1714); color:#f4efe9; font:italic 17px/1.2 var(--font-body); box-shadow:inset 0 2px 7px rgba(0,0,0,.46); }\n.field input::placeholder { color:#b4b7aa; opacity:.86; }\n.password-row { display:flex; align-items:center; justify-content:space-between; gap:12px; }\n.recovery-note { color:#d2b978; font:500 15px/1.2 var(--font-body); text-decoration:underline; text-decoration-color:rgba(210,185,120,.62); text-underline-offset:3px; }\n.submit-wrap { position:relative; margin:10px 0 0 20px; }\n.submit-button { width:100%; min-height:66px; padding:10px 24px 10px 70px; border:1px solid #b18b4c; border-radius:2px; color:#1c170e; background:linear-gradient(180deg,#f0dba2 0%,#d4b879 52%,#bd9859 100%); font:700 18px/1.2 var(--font-title); letter-spacing:.035em; text-align:center; box-shadow:inset 0 1px 0 rgba(255,248,215,.54), inset 0 -2px 0 rgba(101,72,32,.2); }\n.seal { position:absolute; left:-23px; top:50%; transform:translateY(-50%); width:76px; height:76px; display:grid; place-items:center; border:2px solid #d1b274; border-radius:50%; background:radial-gradient(circle at 36% 28%,#5b624a,#202923 63%,#101815); box-shadow:inset 0 0 0 4px #111814, inset 0 0 0 5px rgba(214,183,117,.66); }\n.seal img { width:43px; height:43px; object-fit:cover; border-radius:50%; filter:none; }\n.switch-copy { margin:4px 0 0; text-align:center; color:#c8c9bd; font:500 16px/1.45 var(--font-body); }\n.switch-copy strong { color:#f0dba2; font-weight:600; text-decoration:underline; text-decoration-color:rgba(240,219,162,.6); text-underline-offset:3px; }\n.supabase-note { margin-top:7px; padding:12px 14px; border-top:1px solid rgba(188,172,133,.42); border-bottom:1px solid rgba(188,172,133,.22); color:#d0d0c4; font:400 14px/1.45 var(--font-body); }\n.supabase-note strong { display:block; margin-bottom:3px; color:#dfc88d; font:600 13px/1.35 var(--font-title); letter-spacing:.03em; }\n.glyph-foot { display:flex; justify-content:center; gap:36px; margin:22px auto 0; padding:16px 24px 0; width:min(100%, 490px); border-top:1px solid rgba(175,164,128,.26); color:#aaa78e; }\n.glyph-foot i { display:inline-block; font-size:22px; line-height:1; color:#a8a58d; text-shadow:0 1px 0 #0a100d; }\n.glyph-foot img { width:24px; height:24px; object-fit:contain; filter:grayscale(1) sepia(.35) brightness(1.25); opacity:.72; }\n@media (max-width: 700px) {\n  .gate-frame { min-height:100vh; margin:0 auto; padding:7px; clip-path:polygon(50% 0,60% 2%,71% 7%,83% 14%,93% 23%,100% 30%,100% 100%,0 100%,0 30%,7% 23%,17% 14%,29% 7%,40% 2%); }\n  .gate-iron { min-height:100vh; padding-bottom:22px; clip-path:polygon(50% 0,60% 2%,71% 7%,83% 14%,93% 23%,100% 30%,100% 100%,0 100%,0 30%,7% 23%,17% 14%,29% 7%,40% 2%); }\n  .gate-iron::before { inset:6px; clip-path:polygon(50% 0,60% 2%,71% 7%,83% 14%,93% 23%,100% 30%,100% 100%,0 100%,0 30%,7% 23%,17% 14%,29% 7%,40% 2%); }\n  .gate-content { width:calc(100% - 38px); padding-top:94px; padding-bottom:20px; }\n  .gate-header { padding-bottom:18px; }\n  .gate-header h1 { font-size:clamp(22px,7vw,30px); }\n  .gate-header p { font-size:17px; }\n  .tabs { gap:6px; }\n  .tab { font-size:13px; min-height:46px; }\n  .auth-form { gap:17px; }\n  .field label { font-size:14px; }\n  .field input { min-height:52px; font-size:17px; }\n  .password-row { align-items:flex-start; flex-direction:column; }\n  .submit-wrap { margin-left:16px; }\n  .submit-button { min-height:64px; padding-left:56px; font-size:15px; }\n  .seal { width:66px; height:66px; left:-19px; }\n  .seal img { width:37px; height:37px; }\n  .glyph-foot { gap:23px; margin-top:22px; padding-inline:10px; }\n}\n</style>\n<div class=\"relative isolate min-h-screen overflow-x-clip bg-[#091713] font-[var(--font-body)] text-[#f4efe9] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <div aria-hidden=\"true\" class=\"fixed inset-0 z-0\" data-kid=\"1-1\" data-name=\"background image layer\">\n        <img alt=\"Trilha de floresta em luz baixa, fotografia de Darya Karaliova no Unsplash.\" class=\"absolute inset-0 h-full w-full object-cover object-center opacity-65\" data-kid=\"1-1-1\" data-name=\"forest trail background photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1732135297799-0e4e29223e00?auto=format&w=1800&q=80&fit=crop\"/>\n        <div class=\"absolute inset-0 bg-[linear-gradient(180deg,rgba(5,12,10,.38),rgba(5,12,10,.62)_42%,rgba(5,12,10,.82))]\" data-kid=\"1-1-2\" data-name=\"vertical dark gradient overlay\">\n        </div>\n        <div class=\"absolute inset-0 bg-[linear-gradient(90deg,rgba(3,9,7,.45),transparent_27%,transparent_73%,rgba(3,9,7,.5))]\" data-kid=\"1-1-3\" data-name=\"horizontal dark edge gradient overlay\">\n        </div>\n    </div>\n    <main class=\"relative z-10 flex min-h-screen items-start justify-center px-3 py-0 md:items-center md:px-6 md:py-3\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-label=\"Portal dos Aventureiros\" class=\"gate-frame\" data-kid=\"1-2-1\" data-name=\"ornamental gate-frame portal container\">\n            <div class=\"gate-iron\" data-kid=\"1-2-1-1\" data-name=\"iron gate inner panel\">\n                <div class=\"gate-content\" data-kid=\"1-2-1-1-1\" data-name=\"gate content column\">\n                    <header class=\"gate-header\" data-kid=\"1-2-1-1-1-1\" data-name=\"gate portal header\">\n                        <div aria-hidden=\"true\" class=\"crest-box\" data-kid=\"1-2-1-1-1-1-1\" data-name=\"crest emblem frame\">\n                            <svg aria-hidden=\"true\" data-kid=\"1-2-1-1-1-1-1-1\" data-name=\"gold shield crest icon\" fill=\"none\" height=\"38\" viewbox=\"0 0 48 52\" width=\"34\">\n                                <path d=\"M24 2 44 9v14c0 14-8 22-20 27C12 45 4 37 4 23V9z\" fill=\"rgba(11, 19, 18, 0.9)\" stroke=\"rgba(240, 219, 162, 0.9)\" stroke-width=\"1.8\">\n                                </path>\n                                <path d=\"M24 10v32M14 18h20M15 30h18\" stroke=\"rgba(240, 219, 162, 0.9)\" stroke-linecap=\"round\" stroke-width=\"1.5\">\n                                </path>\n                                <circle cx=\"24\" cy=\"18\" fill=\"rgba(240, 219, 162, 0.95)\" r=\"2.5\">\n                                </circle>\n                            </svg>\n                        </div>\n                        <h1 data-kid=\"1-2-1-1-1-1-2\" data-name=\"portal title headline\">\n                            PORTAL DOS AVENTUREIROS\n                        </h1>\n                        <p data-kid=\"1-2-1-1-1-1-3\" data-name=\"portal tagline text\">\n                            ELEMENTUM — As crónicas começam aqui\n                        </p>\n                    </header>\n                    <div aria-label=\"Estado de autenticação\" class=\"tabs\" data-kid=\"1-2-1-1-1-2\" data-name=\"authentication mode tabs\">\n                        <div class=\"tab active\" data-kid=\"1-2-1-1-1-2-1\" data-name=\"login tab (active)\">\n                            ENTRAR\n                        </div>\n                        <div class=\"tab\" data-kid=\"1-2-1-1-1-2-2\" data-name=\"create account tab\">\n                            CRIAR CONTA\n                        </div>\n                    </div>\n                    <form aria-label=\"Entrar no Elementum\" class=\"auth-form\" data-kid=\"1-2-1-1-1-3\" data-name=\"login form\">\n                        <div class=\"field\" data-kid=\"1-2-1-1-1-3-1\" data-name=\"email field group\">\n                            <label data-kid=\"1-2-1-1-1-3-1-1\" data-name=\"email field label\" for=\"portal-email\">\n                                E-mail do Reino\n                            </label>\n                            <input autocomplete=\"email\" data-kid=\"1-2-1-1-1-3-1-2\" data-name=\"email input field\" id=\"portal-email\" placeholder=\"seu-email@reino.com\" type=\"email\"/>\n                        </div>\n                        <div class=\"field\" data-kid=\"1-2-1-1-1-3-2\" data-name=\"password field group\">\n                            <div class=\"password-row\" data-kid=\"1-2-1-1-1-3-2-1\" data-name=\"password label and recovery row\">\n                                <label data-kid=\"1-2-1-1-1-3-2-1-1\" data-name=\"password field label\" for=\"portal-password\">\n                                    Senha Arcana\n                                </label>\n                                <span class=\"recovery-note\" data-kid=\"1-2-1-1-1-3-2-1-2\" data-name=\"forgot password recovery link\">\n                                    Esqueceu sua senha?\n                                </span>\n                            </div>\n                            <input autocomplete=\"current-password\" data-kid=\"1-2-1-1-1-3-2-2\" data-name=\"password input field\" id=\"portal-password\" placeholder=\"Sua senha secreta\" type=\"password\"/>\n                        </div>\n                        <div class=\"submit-wrap\" data-kid=\"1-2-1-1-1-3-3\" data-name=\"submit button container with seal\">\n                            <button class=\"submit-button\" data-kid=\"1-2-1-1-1-3-3-1\" data-name=\"primary login call-to-action button\" type=\"button\">\n                                Adentrar ao Reino\n                            </button>\n                            <span aria-hidden=\"true\" class=\"seal\" data-kid=\"1-2-1-1-1-3-3-2\" data-name=\"circular wax seal badge\">\n                                <img alt=\"\" data-kid=\"1-2-1-1-1-3-3-2-1\" data-name=\"seal emblem image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/0087bbb4-ab33-4bd5-97ed-3ecab494db32/6121d9f3a402447e99deac3b71d8fd39.jpg\"/>\n                            </span>\n                        </div>\n                        <p class=\"switch-copy\" data-kid=\"1-2-1-1-1-3-4\" data-name=\"switch to signup prompt\">\n                            Novo nestas terras?\n                            <strong data-kid=\"1-2-1-1-1-3-4-1\" data-name=\"sign-up link\">\n                                Forjar uma nova conta\n                            </strong>\n                        </p>\n                        <div class=\"supabase-note\" data-kid=\"1-2-1-1-1-3-5\" data-name=\"Supabase connection note\">\n                            <strong data-kid=\"1-2-1-1-1-3-5-1\" data-name=\"Supabase note heading\">\n                                CONECTADO AO SUPABASE:\n                            </strong>\n                            As contas criadas são salvas e sincronizadas diretamente no seu projeto Supabase.\n                        </div>\n                    </form>\n                    <div aria-hidden=\"true\" class=\"glyph-foot\" data-kid=\"1-2-1-1-1-4\" data-name=\"footer glyph row\">\n                        <i class=\"ti ti-shield\" data-kid=\"1-2-1-1-1-4-1\" data-name=\"shield glyph icon\">\n                        </i>\n                        <i class=\"ti ti-moneybag\" data-kid=\"1-2-1-1-1-4-2\" data-name=\"money bag glyph icon\">\n                        </i>\n                        <img alt=\"\" data-kid=\"1-2-1-1-1-4-3\" data-name=\"decorative emblem image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/0087bbb4-ab33-4bd5-97ed-3ecab494db32/6121d9f3a402447e99deac3b71d8fd39.jpg\"/>\n                        <i class=\"ti ti-swords\" data-kid=\"1-2-1-1-1-4-4\" data-name=\"swords glyph icon\">\n                        </i>\n                        <i class=\"ti ti-star\" data-kid=\"1-2-1-1-1-4-5\" data-name=\"star glyph icon\">\n                        </i>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n</div>\n",
