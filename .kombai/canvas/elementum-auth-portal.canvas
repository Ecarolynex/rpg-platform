      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=EB+Garamond:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n\n.gatehouse-page { --ink:#091713; --iron:#121a18; --iron-light:#202a26; --stone:#4b5144; --stone-deep:#30362f; --moss:#596449; --gold:#c7a66c; --gold-lit:#f0dba2; --parchment:#f4efe9; --muted:#c0c0b2; display:flow-root; min-height:100vh; padding-block:58px; position:relative; isolation:isolate; overflow-x:clip; overflow-y:visible; background:#08110f; color:var(--parchment); font-family:'EB Garamond',Georgia,serif; }\n.gatehouse-page * { box-sizing:border-box; }\n.forest-backdrop { position:absolute; inset:0; z-index:-3; overflow:hidden; }\n.forest-backdrop img { width:100%; height:100%; object-fit:cover; object-position:center 48%; opacity:.57; filter:brightness(.42) saturate(.68); }\n.forest-shade { position:absolute; inset:0; z-index:-2; background:linear-gradient(90deg,rgba(5,11,10,.53),rgba(5,11,10,.24) 22%,rgba(5,11,10,.24) 78%,rgba(5,11,10,.57)),linear-gradient(180deg,rgba(4,9,8,.3),rgba(4,10,9,.58)); }\n.masonry-wall { width:min(1192px,calc(100% - 48px)); min-height:calc(100vh - 116px); margin:58px auto; position:relative; display:grid; grid-template-columns:86px minmax(0,1fr) 86px; background:#262d27; border:1px solid #6a6c57; box-shadow:0 18px 44px rgba(0,0,0,.48); }\n.pier { position:relative; min-width:0; background:linear-gradient(90deg,#30362f,#55594a 47%,#383e35); border-inline:1px solid rgba(199,166,108,.35); overflow:hidden; }\n.pier::before { content:''; position:absolute; inset:0; opacity:.42; background:repeating-linear-gradient(180deg,transparent 0 78px,rgba(12,17,14,.68) 79px 82px),repeating-linear-gradient(90deg,rgba(9,14,11,.26) 0 1px,transparent 1px 42px); }\n.pier::after { content:''; position:absolute; left:10px; top:9%; width:5px; height:26%; background:linear-gradient(180deg,transparent,#68714e 35%,#3d523e 72%,transparent); opacity:.54; }\n.pier.right::after { left:auto; right:10px; top:55%; height:23%; }\n.pier-cap { position:absolute; z-index:1; left:0; right:0; height:17px; background:linear-gradient(180deg,#68705c,#333a32); border-block:1px solid rgba(217,183,121,.4); }\n.pier-cap.top { top:0; }\n.pier-cap.bottom { bottom:0; }\n.arch-interior { min-width:0; display:flex; flex-direction:column; position:relative; background:#101a17; border-inline:3px solid #171c19; box-shadow:inset 8px 0 0 #363a31,inset -8px 0 0 #363a31; }\n.arch-interior::before { content:''; position:absolute; inset:0; pointer-events:none; border-inline:1px solid rgba(199,166,108,.44); z-index:3; }\n.lintel { min-height:160px; padding:28px clamp(25px,5vw,72px) 24px; display:flex; align-items:center; justify-content:space-between; gap:32px; position:relative; background:linear-gradient(180deg,#343a32 0%,#252d28 56%,#171e1b 100%); border-bottom:5px solid #604f35; box-shadow:inset 0 -1px 0 rgba(240,219,162,.32); }\n.lintel::before,.lintel::after { content:''; position:absolute; bottom:7px; width:24%; height:1px; background:rgba(199,166,108,.42); }\n.lintel::before { left:0; }.lintel::after { right:0; }\n.lintel-copy { min-width:0; }\n.portal-title { margin:0 0 17px; color:var(--gold-lit); font-family:'Cinzel',Georgia,serif; font-size:clamp(19px,2vw,27px); line-height:1.2; font-weight:600; letter-spacing:.065em; }\n.brand-row { display:flex; align-items:center; gap:15px; }\n.brand-crest { width:47px; height:50px; flex:0 0 auto; display:grid; place-items:center; border:1px solid #96845b; background:#101713; box-shadow:inset 0 0 0 3px #31352e; }\n.brand-row p { color:#e6dfc8; font-family:'EB Garamond',Georgia,serif; font-size:19px; line-height:1.3; margin:0; }\n.brand-row strong { color:var(--gold-lit); font-family:'Cinzel',Georgia,serif; font-weight:600; letter-spacing:.07em; }\n.brand-row em { color:#d6d0c1; font-size:15px; }\n.lintel-mark { color:#b8a577; font-family:'Cinzel',Georgia,serif; font-size:12px; letter-spacing:.16em; text-transform:uppercase; padding:9px 0 9px 20px; border-left:1px solid rgba(199,166,108,.5); white-space:nowrap; }\n.tabs { display:grid; grid-template-columns:1fr 1fr; gap:0; padding:0 clamp(25px,5vw,72px); background:#252b25; border-bottom:1px solid #545343; }\n.tab-plate { min-height:61px; display:grid; place-items:center; padding:10px 16px; color:#b6b6a7; background:linear-gradient(180deg,#41463c,#30372f); border:1px solid #66634f; border-top:0; font-family:'Cinzel',Georgia,serif; font-size:15px; letter-spacing:.13em; font-weight:600; text-align:center; }\n.tab-plate + .tab-plate { border-left:0; }\n.tab-plate.active { color:#f1dda6; background:linear-gradient(180deg,#514c38,#393b30); box-shadow:inset 0 2px 0 #d0ad67,inset 0 -2px 0 #171b17; }\n.form-plane { width:min(100%,900px); margin:0 auto; padding:27px clamp(25px,5vw,72px) 24px; flex:1; display:flex; flex-direction:column; justify-content:center; }\n.form-heading { margin:0 0 20px; color:#c9c3ad; font-size:17px; font-weight:500; letter-spacing:.025em; }\n.registration-form { display:flex; flex-direction:column; gap:17px; }\n.field { display:flex; flex-direction:column; gap:7px; min-width:0; }\n.field label { color:#e2dccd; font-size:15px; line-height:1.25; font-weight:600; }\n.field input { width:100%; min-height:48px; padding:11px 15px; color:#f6f0e4; background:#09120f; border:1px solid #767363; border-radius:3px; box-shadow:inset 0 2px 4px rgba(0,0,0,.48); font-family:'EB Garamond',Georgia,serif; font-size:17px; outline:none; }\n.field input::placeholder { color:#9fa297; opacity:1; font-size:16px; font-style:italic; }\n.field input:focus { border-color:#d6b873; box-shadow:0 0 0 2px rgba(214,184,115,.22),inset 0 2px 4px rgba(0,0,0,.48); }\n.password-grid { display:grid; grid-template-columns:1fr 1fr; gap:18px; }\n.register-submit { width:100%; min-height:60px; margin-top:2px; padding:12px 24px; display:flex; justify-content:center; align-items:center; color:#1c1710; background:linear-gradient(180deg,#e5ca89,#c6a15e); border:1px solid #f0dba2; box-shadow:inset 0 1px rgba(255,255,255,.42),0 4px 0 #453b2b; font-family:'Cinzel',Georgia,serif; font-size:17px; font-weight:700; letter-spacing:.055em; text-align:center; }\n.switch-prompt { margin:2px 0 0; text-align:center; color:#d0cbbd; font-size:16px; }\n.switch-prompt span { color:#f0dba2; text-decoration:underline; text-decoration-color:rgba(240,219,162,.56); text-underline-offset:3px; font-weight:600; }\n.sill { min-height:79px; padding:14px 24px 13px; display:flex; justify-content:center; align-items:center; gap:clamp(24px,6vw,72px); background:linear-gradient(180deg,#34392f,#262d28); border-top:4px solid #68583c; box-shadow:inset 0 1px rgba(240,219,162,.24); }\n.glyph { width:38px; height:38px; display:grid; place-items:center; color:#b4aa8d; background:transparent; border:0; box-shadow:none; font-size:23px; }\n.glyph.phoenix { color:#e0bd73; }\n.glyph img { width:22px; height:22px; object-fit:contain; filter:sepia(.25) saturate(.75); }\n@media (max-width:800px) { .masonry-wall { width:min(100% - 24px,700px); margin:18px auto; grid-template-columns:19px minmax(0,1fr) 19px; min-height:calc(100vh - 36px); } .pier { background:linear-gradient(90deg,#353b32,#4d5144,#343a32); } .pier::before { opacity:.18; } .arch-interior { box-shadow:inset 3px 0 0 #363a31,inset -3px 0 0 #363a31; } .lintel { min-height:148px; padding:24px 20px; flex-direction:column; align-items:flex-start; justify-content:center; gap:13px; } .portal-title { margin-bottom:10px; font-size:19px; } .lintel-mark { display:none; } .brand-row p { font-size:17px; } .brand-row em { font-size:14px; } .tabs { padding:0 12px; } .tab-plate { min-height:56px; font-size:13px; letter-spacing:.08em; } .form-plane { padding:24px 22px; } }\n@media (max-width:520px) { .masonry-wall { width:100%; margin:0 auto; grid-template-columns:10px minmax(0,1fr) 10px; min-height:100vh; border-inline:0; } .pier { border-inline:0; } .pier-cap { height:9px; } .arch-interior { border-inline-width:1px; } .lintel { min-height:140px; padding:22px 16px; } .portal-title { font-size:16px; letter-spacing:.045em; } .brand-crest { width:40px; height:43px; } .brand-row { gap:11px; } .brand-row p { font-size:16px; } .brand-row em { font-size:13px; } .tabs { padding:0; } .tab-plate { min-height:52px; padding-inline:6px; font-size:12px; } .form-plane { padding:20px 16px 22px; } .registration-form { gap:15px; } .field label { font-size:14px; } .field input { min-height:46px; padding-inline:12px; font-size:16px; } .field input::placeholder { font-size:14px; } .password-grid { grid-template-columns:1fr; gap:15px; } .register-submit { min-height:56px; font-size:14px; letter-spacing:.025em; padding-inline:12px; } .switch-prompt { font-size:14px; line-height:1.5; } .sill { min-height:64px; gap:clamp(12px,5vw,22px); padding-inline:10px; } .glyph { width:32px; height:32px; font-size:19px; } .glyph img { width:19px; height:19px; } }\n</style>\n<div class=\"gatehouse-page min-h-screen\" data-kid=\"1\" data-name=\"gatehouse page container\">\n    <div aria-hidden=\"true\" class=\"forest-backdrop\" data-kid=\"1-1\" data-name=\"forest backdrop layer\">\n        <img alt=\"Woodland with old stone ruins, photographed by Maik Astheimer on Unsplash\" data-kid=\"1-1-1\" data-name=\"woodland ruins background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1786712308232-5be9fc460622?auto=format&w=1800&q=80&fit=crop\"/>\n    </div>\n    <div aria-hidden=\"true\" class=\"forest-shade\" data-kid=\"1-2\" data-name=\"forest gradient shade overlay\">\n    </div>\n    <main aria-label=\"Portal Elementum — criar conta\" class=\"masonry-wall\" data-kid=\"1-3\" data-name=\"masonry wall portal container\">\n        <div aria-hidden=\"true\" class=\"pier\" data-kid=\"1-3-1\" data-name=\"left stone pier structure\">\n            <span class=\"pier-cap top\" data-kid=\"1-3-1-1\" data-name=\"left pier top capstone\">\n            </span>\n            <span class=\"pier-cap bottom\" data-kid=\"1-3-1-2\" data-name=\"left pier bottom capstone\">\n            </span>\n        </div>\n        <section class=\"arch-interior\" data-kid=\"1-3-2\" data-name=\"arch-style portal interior\">\n            <header class=\"lintel\" data-kid=\"1-3-2-1\" data-name=\"portal header lintel\">\n                <div class=\"lintel-copy\" data-kid=\"1-3-2-1-1\" data-name=\"portal title block\">\n                    <h1 class=\"portal-title\" data-kid=\"1-3-2-1-1-1\" data-name=\"hero portal headline\">\n                        PORTAL DOS AVENTUREIROS\n                    </h1>\n                    <div class=\"brand-row\" data-kid=\"1-3-2-1-1-2\" data-name=\"brand row with crest and name\">\n                        <div aria-hidden=\"true\" class=\"brand-crest\" data-kid=\"1-3-2-1-1-2-1\" data-name=\"brand crest frame\">\n                            <svg data-kid=\"1-3-2-1-1-2-1-1\" data-name=\"crossed-key crest icon\" fill=\"none\" height=\"36\" viewbox=\"0 0 48 52\" width=\"33\">\n                                <path d=\"M24 2 44 9v14c0 14-8 22-20 27C12 45 4 37 4 23V9z\" fill=\"rgba(11,19,18,.9)\" stroke=\"rgba(240,219,162,.9)\" stroke-width=\"1.8\">\n                                </path>\n                                <path d=\"M24 10v32M14 18h20M15 30h18\" stroke=\"rgba(240,219,162,.9)\" stroke-linecap=\"round\" stroke-width=\"1.5\">\n                                </path>\n                                <circle cx=\"24\" cy=\"18\" fill=\"rgba(240,219,162,.95)\" r=\"2.5\">\n                                </circle>\n                            </svg>\n                        </div>\n                        <p data-kid=\"1-3-2-1-1-2-2\" data-name=\"brand name paragraph\">\n                            <strong data-kid=\"1-3-2-1-1-2-2-1\" data-name=\"brand name text\">\n                                ELEMENTUM\n                            </strong>\n                            <em data-kid=\"1-3-2-1-1-2-2-2\" data-name=\"brand tagline\">\n                                — As crónicas começam aqui\n                            </em>\n                        </p>\n                    </div>\n                </div>\n            </header>\n            <div aria-label=\"Estado de autenticação\" class=\"tabs\" data-kid=\"1-3-2-2\" data-name=\"login/register tabs row\">\n                <div class=\"tab-plate\" data-kid=\"1-3-2-2-1\" data-name=\"login tab plate\">\n                    ENTRAR\n                </div>\n                <div aria-current=\"page\" class=\"tab-plate active\" data-kid=\"1-3-2-2-2\" data-name=\"create account active tab plate\">\n                    CRIAR CONTA\n                </div>\n            </div>\n            <section class=\"form-plane\" data-kid=\"1-3-2-3\" data-name=\"registration form plane\">\n                <form class=\"registration-form\" data-kid=\"1-3-2-3-1\" data-name=\"registration form\">\n                    <div class=\"field\" data-kid=\"1-3-2-3-1-1\" data-name=\"adventurer username field\">\n                        <label data-kid=\"1-3-2-3-1-1-1\" data-name=\"adventurer username label\" for=\"reg-usuario\">\n                            Nome de Aventureiro (Usuário)\n                        </label>\n                        <input autocomplete=\"username\" data-kid=\"1-3-2-3-1-1-2\" data-name=\"adventurer username input field\" id=\"reg-usuario\" placeholder=\"Ex: MagoEldrin, Valquíria...\" type=\"text\"/>\n                    </div>\n                    <div class=\"field\" data-kid=\"1-3-2-3-1-2\" data-name=\"email field\">\n                        <label data-kid=\"1-3-2-3-1-2-1\" data-name=\"email label\" for=\"reg-email\">\n                            E-mail do Reino\n                        </label>\n                        <input autocomplete=\"email\" data-kid=\"1-3-2-3-1-2-2\" data-name=\"email input field\" id=\"reg-email\" placeholder=\"aventureiro@reino.com\" type=\"email\"/>\n                    </div>\n                    <div class=\"password-grid\" data-kid=\"1-3-2-3-1-3\" data-name=\"password fields grid\">\n                        <div class=\"field\" data-kid=\"1-3-2-3-1-3-1\" data-name=\"password field\">\n                            <label data-kid=\"1-3-2-3-1-3-1-1\" data-name=\"password label\" for=\"reg-senha\">\n                                Senha\n                            </label>\n                            <input autocomplete=\"new-password\" data-kid=\"1-3-2-3-1-3-1-2\" data-name=\"password input field\" id=\"reg-senha\" placeholder=\"Mínimo 3 caracteres\" type=\"password\"/>\n                        </div>\n                        <div class=\"field\" data-kid=\"1-3-2-3-1-3-2\" data-name=\"confirm password field\">\n                            <label data-kid=\"1-3-2-3-1-3-2-1\" data-name=\"confirm password label\" for=\"reg-confirma-senha\">\n                                Confirmar Senha\n                            </label>\n                            <input autocomplete=\"new-password\" data-kid=\"1-3-2-3-1-3-2-2\" data-name=\"confirm password input field\" id=\"reg-confirma-senha\" placeholder=\"Repita a senha\" type=\"password\"/>\n                        </div>\n                    </div>\n                    <button class=\"register-submit\" data-kid=\"1-3-2-3-1-4\" data-name=\"registration submit button\" type=\"button\">\n                        Forjar Conta de Aventureiro\n                    </button>\n                    <p class=\"switch-prompt\" data-kid=\"1-3-2-3-1-5\" data-name=\"switch to login prompt\">\n                        Já possui uma lenda registrada?\n                        <span data-kid=\"1-3-2-3-1-5-1\" data-name=\"switch to login link text\">\n                            Entrar com conta existente\n                        </span>\n                    </p>\n                </form>\n            </section>\n            <div aria-hidden=\"true\" class=\"sill\" data-kid=\"1-3-2-4\" data-name=\"decorative sill icon row\">\n                <span class=\"glyph\" data-kid=\"1-3-2-4-1\" data-name=\"shield glyph container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-shield\" data-kid=\"1-3-2-4-1-1\" data-name=\"shield icon\">\n                    </i>\n                </span>\n                <span class=\"glyph\" data-kid=\"1-3-2-4-2\" data-name=\"shopping bag glyph container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-shopping-bag\" data-kid=\"1-3-2-4-2-1\" data-name=\"shopping bag icon\">\n                    </i>\n                </span>\n                <span class=\"glyph phoenix\" data-kid=\"1-3-2-4-3\" data-name=\"phoenix glyph\">\n                    <img alt=\"\" data-kid=\"1-3-2-4-3-1\" data-name=\"forged phoenix medallion image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/0087bbb4-ab33-4bd5-97ed-3ecab494db32/6121d9f3a402447e99deac3b71d8fd39.jpg\"/>\n                </span>\n                <span class=\"glyph\" data-kid=\"1-3-2-4-4\" data-name=\"swords glyph container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-swords\" data-kid=\"1-3-2-4-4-1\" data-name=\"swords icon\">\n                    </i>\n                </span>\n                <span class=\"glyph\" data-kid=\"1-3-2-4-5\" data-name=\"star glyph container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-star\" data-kid=\"1-3-2-4-5-1\" data-name=\"star icon\">\n                    </i>\n                </span>\n            </div>\n        </section>\n        <div aria-hidden=\"true\" class=\"pier right\" data-kid=\"1-3-3\" data-name=\"right stone pier structure\">\n            <span class=\"pier-cap top\" data-kid=\"1-3-3-1\" data-name=\"right pier top capstone\">\n            </span>\n            <span class=\"pier-cap bottom\" data-kid=\"1-3-3-2\" data-name=\"right pier bottom capstone\">\n            </span>\n        </div>\n    </main>\n</div>\n",
