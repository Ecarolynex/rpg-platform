    "var_e0bfdd0280a3": {
      "type": "variant",
      "label": "Amber Forge — register style",
      "parentId": "var_8b8c971c2455",
      "themeId": null,
      "rect": {
        "x": 13860,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n.intact-page{--ink:#091713;--deep:#0d1715;--panel:#102b28;--panel-raised:#1a3d39;--parchment:#f4efe9;--parchment-dim:#d9cdb9;--gold:#c98d43;--gold-bright:#f4d18a;--forest:#174d48;--muted:#a8b3ae;--stone:#393a32;--iron:#111714;--line:rgba(217,158,76,.58);--display:'Cinzel',Georgia,serif;--body:'EB Garamond',Georgia,serif;position:relative;min-height:100vh;isolation:isolate;overflow-x:clip;background:var(--ink);color:var(--parchment);font-family:var(--body);font-size:18px;line-height:1.45}\n.intact-page *{box-sizing:border-box}\n.forest-image{position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;object-position:center 54%;z-index:-3;filter:brightness(.54) saturate(.9) contrast(1.08) sepia(.06)}\n.forest-shade{position:absolute;inset:0;z-index:-2;background:linear-gradient(118deg,rgba(222,157,73,.24) 0%,rgba(178,126,57,.11) 24%,transparent 54%),linear-gradient(180deg,rgba(25,17,9,.25),rgba(7,18,15,.74) 45%,rgba(5,12,10,.88)),linear-gradient(90deg,rgba(4,12,10,.6),transparent 23%,transparent 77%,rgba(4,12,10,.62))}\n.page-grain{display:none}\n.portal-stage{min-height:100vh;display:flex;align-items:flex-start;justify-content:center;padding:26px 22px 22px;position:relative}\n.gate-outer{position:relative;width:min(100%,760px);min-height:1100px;clip-path:polygon(0 100%,0 16%,47.4% 0,52.6% 0,100% 16%,100% 100%);padding:13px;background:linear-gradient(130deg,#8e6237 0%,#353c30 9%,#785731 17%,#242b22 27%,#5c7047 47%,#17221b 65%,#a07a43 80%,#29342a 91%,#392c1d 100%);filter:drop-shadow(0 22px 32px rgba(0,0,0,.5))}\n.stone-material{position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;object-position:center;opacity:.36;mix-blend-mode:soft-light;filter:sepia(.28) saturate(.82) brightness(.69) contrast(1.22);pointer-events:none}\n.stone-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(31,29,18,.28),rgba(9,16,13,.06) 14%,rgba(9,16,13,.06) 86%,rgba(31,29,18,.28)),linear-gradient(180deg,rgba(118,75,30,.13),rgba(8,15,12,.58));pointer-events:none}\n.masonry-joints{position:absolute;inset:0;opacity:.51;pointer-events:none;background:linear-gradient(90deg,transparent 11.5%,rgba(224,171,89,.28) 11.65%,transparent 11.85%,transparent 88%,rgba(224,171,89,.28) 88.15%,transparent 88.35%),linear-gradient(180deg,transparent 22%,rgba(117,148,77,.22) 22.2%,transparent 22.4%,transparent 39%,rgba(224,171,89,.2) 39.2%,transparent 39.4%,transparent 61%,rgba(117,148,77,.2) 61.2%,transparent 61.4%)}\n.gate-inner{position:relative;min-height:1074px;clip-path:polygon(0 100%,0 16.6%,47.5% 1.6%,52.5% 1.6%,100% 16.6%,100% 100%);background:linear-gradient(180deg,#111a16 0%,#101a17 28%,#0f1b17 100%);border:1px solid rgba(235,222,186,.24);overflow:hidden}\n.gate-inner:before{content:\"\";position:absolute;inset:0;clip-path:polygon(1.2% 100%,1.2% 17.4%,47.7% 2.8%,52.3% 2.8%,98.8% 17.4%,98.8% 100%);border:1px solid rgba(218,206,168,.34);pointer-events:none}\n.gate-inner:after{content:\"\";position:absolute;inset:10px;clip-path:polygon(0 100%,0 16.5%,47.4% 0,52.6% 0,100% 16.5%,100% 100%);border:1px solid rgba(0,0,0,.72);pointer-events:none}\n.gate-moss{position:absolute;top:19%;bottom:5%;width:28px;pointer-events:none;opacity:.82;background:linear-gradient(180deg,transparent 0%,rgba(76,116,53,.82) 24%,rgba(45,91,55,.54) 34%,transparent 46%,rgba(87,112,45,.78) 66%,transparent 83%);filter:saturate(.92)}\n.gate-moss.left{left:11px;clip-path:polygon(0 0,100% 8%,66% 23%,100% 32%,43% 48%,75% 59%,30% 73%,62% 90%,0 100%)}\n.gate-moss.right{right:11px;clip-path:polygon(100% 0,0 8%,34% 23%,0 32%,57% 48%,25% 59%,70% 73%,38% 90%,100% 100%)}\n.portal-content{position:relative;z-index:2;width:min(100%,566px);margin:0 auto}\n.portal-heading{text-align:center;padding:144px 20px 20px;border-bottom:1px solid rgba(199,145,67,.45)}\n.brand-mark{width:56px;height:60px;margin:0 auto 13px;display:grid;place-items:center;border:1px solid rgba(221,163,78,.82);background:linear-gradient(155deg,#243b2b,#161c14);box-shadow:inset 0 0 0 3px rgba(122,78,31,.35)}\n.brand-mark svg{width:36px;height:39px;display:block}\n.portal-heading h1{margin:0;color:#f4d18a;font-family:var(--display);font-size:clamp(22px,3vw,29px);font-weight:600;letter-spacing:.105em;line-height:1.25;text-transform:uppercase}\n.portal-heading p{margin:9px 0 0;color:#e8d7b5;font-family:var(--body);font-size:19px;letter-spacing:.012em}\n.portal-tabs{display:grid;grid-template-columns:1fr 1fr;margin:23px 0 25px;padding:0;border:1px solid rgba(174,141,83,.7);background:#111a17}\n.portal-tab{min-height:53px;padding:13px 10px;border:0;background:linear-gradient(180deg,#343c2d,#20291e);color:#c3bda7;font-family:var(--display);font-size:14px;font-weight:600;letter-spacing:.105em;text-transform:uppercase}\n.portal-tab + .portal-tab{border-left:1px solid rgba(199,145,67,.38)}\n.portal-tab.active{position:relative;background:linear-gradient(180deg,#55623c,#2f432d);color:#f4d18a;box-shadow:inset 0 3px 0 rgba(244,209,138,.72),inset 0 -3px 0 rgba(0,0,0,.58)}\n.portal-tab.active:after{content:\"\";position:absolute;inset:4px;border:1px solid rgba(244,209,138,.24);pointer-events:none}\n.register-form{display:flex;flex-direction:column;gap:20px;padding:0 20px 30px}\n.field{display:flex;flex-direction:column;gap:8px;min-width:0}\n.field label{color:#e8ddc7;font-family:var(--display);font-size:13px;font-weight:500;letter-spacing:.045em;line-height:1.45}\n.field input{display:block;width:100%;min-height:50px;padding:12px 15px;border:1px solid rgba(203,193,163,.48);border-radius:2px;background:linear-gradient(180deg,#09120f,#0b1512);box-shadow:inset 0 2px 3px rgba(0,0,0,.3);color:var(--parchment);font-family:var(--body);font-size:18px;line-height:1.35}\n.field input::placeholder{color:#a9aaa0;font-family:var(--body);font-size:16px;font-style:italic;opacity:.9}\n.field input:focus{outline:2px solid #f4d18a;outline-offset:2px;border-color:#f4d18a}\n.password-grid{display:grid;grid-template-columns:1fr 1fr;gap:17px}\n.register-submit{width:100%;min-height:60px;margin-top:3px;padding:14px 18px;border:1px solid #b27b34;border-radius:2px;background:linear-gradient(180deg,#f4d18a 0%,#dfaa58 55%,#bd8139 100%);color:#21170b;font-family:var(--display);font-size:16px;font-weight:700;letter-spacing:.075em;text-transform:uppercase;box-shadow:inset 0 1px rgba(255,244,205,.52),inset 0 -2px rgba(74,49,19,.24)}\n.register-submit span{display:inline-flex;align-items:center;justify-content:center;min-height:28px}\n.account-prompt{margin:3px 0 0;text-align:center;color:#c9c9bc;font-size:16px}\n.account-prompt button{padding:0;border:0;background:transparent;color:#f0ca7a;font:inherit;font-weight:600;text-decoration:underline;text-decoration-color:rgba(240,202,122,.72);text-underline-offset:4px}\n.threshold-glyphs{position:absolute;z-index:3;left:50%;bottom:31px;transform:translateX(-50%);width:min(530px,76%);display:flex;align-items:center;justify-content:space-between;padding:15px 27px 10px;border-top:1px solid rgba(214,151,64,.55);border-bottom:1px solid rgba(118,149,80,.34);color:#d8a85d;pointer-events:none}\n.threshold-glyphs img{display:block;width:27px;height:27px;max-width:none;object-fit:contain;color:#d8a85d;opacity:.96;filter:brightness(0) saturate(100%) invert(67%) sepia(43%) saturate(746%) hue-rotate(346deg) brightness(96%) contrast(90%)}\n.threshold-glyphs img:nth-child(3){width:30px;height:30px;color:#f4d18a;opacity:1;filter:brightness(0) saturate(100%) invert(77%) sepia(32%) saturate(740%) hue-rotate(353deg) brightness(100%) contrast(92%)}\n.gate-footline{position:absolute;bottom:17px;left:50%;width:48%;height:1px;transform:translateX(-50%);background:linear-gradient(90deg,transparent,rgba(207,144,57,.62),transparent)}\n@media (min-width:900px){.portal-stage{padding-top:20px}}\n@media (max-width:700px){.portal-stage{padding:10px 8px 14px}.gate-outer{width:100%;min-height:1140px;padding:9px}.gate-inner{min-height:1122px}.portal-heading{padding:120px 20px 18px}.register-form{padding:0 20px 36px}.gate-moss{width:15px}.gate-moss.left{left:8px}.gate-moss.right{right:8px}.threshold-glyphs{width:85%;bottom:31px;padding:13px 18px 9px}.threshold-glyphs img{width:23px;height:23px}.threshold-glyphs img:nth-child(3){width:26px;height:26px}.portal-heading p{font-size:17px}}\n@media (max-width:470px){.portal-content{padding:104px 17px 40px}.portal-heading{padding-bottom:17px}.portal-heading h1{font-size:20px;letter-spacing:.07em}.portal-heading p{font-size:16px}.portal-tabs{margin:19px 0 21px}.portal-tab{min-height:48px;font-size:12px;letter-spacing:.08em}.register-form{gap:17px}.password-grid{grid-template-columns:1fr;gap:17px}.field label{font-size:12px}.field input{min-height:48px;font-size:17px}.register-submit{font-size:14px;letter-spacing:.045em}.account-prompt{font-size:15px}.threshold-glyphs{width:88%;padding-inline:14px}}\n</style>\n<div class=\"intact-page min-h-screen w-full\" data-kid=\"1\" data-name=\"page layout container\">\n    <img alt=\"Trilha em uma floresta temperada, fotografia de Julia Perera no Unsplash.\" class=\"forest-image\" data-kid=\"1-1\" data-name=\"background forest trail photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1722654331197-fbb2ff8edf62?auto=format&w=2000&q=80&fit=crop\"/>\n    <div aria-hidden=\"true\" class=\"forest-shade\" data-kid=\"1-2\" data-name=\"background shading overlay\">\n    </div>\n    <main class=\"portal-stage\" data-kid=\"1-3\" data-name=\"portal authentication stage\">\n        <section aria-label=\"Portal de autenticação Elementum\" class=\"gate-outer\" data-kid=\"1-3-1\" data-name=\"gate authentication panel\">\n            <img alt=\"Ruínas de pedra cobertas por vegetação, fotografia de Sergii Ruchko no Unsplash.\" class=\"stone-material\" data-kid=\"1-3-1-1\" data-name=\"gate stone texture overlay image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1778265731135-a09dbac07173?auto=format&w=1100&q=78&fit=crop\"/>\n            <div aria-hidden=\"true\" class=\"stone-shade\" data-kid=\"1-3-1-2\" data-name=\"gate stone shading overlay\">\n            </div>\n            <div aria-hidden=\"true\" class=\"masonry-joints\" data-kid=\"1-3-1-3\" data-name=\"gate masonry joint line overlay\">\n            </div>\n            <div class=\"gate-inner\" data-kid=\"1-3-1-4\" data-name=\"inner gate content frame\">\n                <span aria-hidden=\"true\" class=\"gate-moss left\" data-kid=\"1-3-1-4-1\" data-name=\"left decorative moss strip\">\n                </span>\n                <span aria-hidden=\"true\" class=\"gate-moss right\" data-kid=\"1-3-1-4-2\" data-name=\"right decorative moss strip\">\n                </span>\n                <header class=\"portal-content portal-heading\" data-kid=\"1-3-1-4-3\" data-name=\"portal heading area\">\n                    <div aria-label=\"Brasão Elementum\" class=\"brand-mark\" data-kid=\"1-3-1-4-3-1\" data-name=\"brand crest badge\">\n                        <svg aria-label=\"Crest Elementum\" data-kid=\"1-3-1-4-3-1-1\" data-name=\"crest emblem icon\" fill=\"none\" role=\"img\" viewbox=\"0 0 48 52\">\n                            <path d=\"M24 2 44 9v14c0 14-8 22-20 27C12 45 4 37 4 23V9z\" fill=\"#0b1312\" stroke=\"#f0dba2\" stroke-width=\"1.8\">\n                            </path>\n                            <path d=\"M24 10v32M14 18h20M15 30h18\" stroke=\"#f0dba2\" stroke-linecap=\"round\" stroke-width=\"1.5\">\n                            </path>\n                            <circle cx=\"24\" cy=\"18\" fill=\"#f0dba2\" r=\"2.5\">\n                            </circle>\n                        </svg>\n                    </div>\n                    <h1 data-kid=\"1-3-1-4-3-2\" data-name=\"portal headline text\">\n                        Portal dos Aventureiros\n                    </h1>\n                    <p data-kid=\"1-3-1-4-3-3\" data-name=\"portal tagline text\">\n                        ELEMENTUM — As crónicas começam aqui\n                    </p>\n                </header>\n                <nav aria-label=\"Autenticação\" class=\"portal-content portal-tabs\" data-kid=\"1-3-1-4-4\" data-name=\"authentication mode tab bar\">\n                    <button aria-selected=\"false\" class=\"portal-tab\" data-kid=\"1-3-1-4-4-1\" data-name=\"login tab button\" type=\"button\">\n                        Entrar\n                    </button>\n                    <button aria-selected=\"true\" class=\"portal-tab active\" data-kid=\"1-3-1-4-4-2\" data-name=\"create account tab button (active)\" type=\"button\">\n                        Criar conta\n                    </button>\n                </nav>\n                <form aria-label=\"Criar conta\" class=\"portal-content register-form\" data-kid=\"1-3-1-4-5\" data-name=\"create account form\">\n                    <div class=\"field\" data-kid=\"1-3-1-4-5-1\" data-name=\"username field container\">\n                        <label data-kid=\"1-3-1-4-5-1-1\" data-name=\"username field label\" for=\"reg-usuario\">\n                            Nome de Aventureiro (Usuário)\n                        </label>\n                        <input autocomplete=\"username\" data-kid=\"1-3-1-4-5-1-2\" data-name=\"username text input field\" id=\"reg-usuario\" placeholder=\"Ex: MagoEldrin, Valquíria...\" type=\"text\"/>\n                    </div>\n                    <div class=\"field\" data-kid=\"1-3-1-4-5-2\" data-name=\"email field container\">\n                        <label data-kid=\"1-3-1-4-5-2-1\" data-name=\"email field label\" for=\"reg-email\">\n                            E-mail do Reino\n                        </label>\n                        <input autocomplete=\"email\" data-kid=\"1-3-1-4-5-2-2\" data-name=\"email text input field\" id=\"reg-email\" placeholder=\"aventureiro@reino.com\" type=\"email\"/>\n                    </div>\n                    <div class=\"password-grid\" data-kid=\"1-3-1-4-5-3\" data-name=\"password fields grid container\">\n                        <div class=\"field\" data-kid=\"1-3-1-4-5-3-1\" data-name=\"password field container\">\n                            <label data-kid=\"1-3-1-4-5-3-1-1\" data-name=\"password field label\" for=\"reg-senha\">\n                                Senha\n                            </label>\n                            <input autocomplete=\"new-password\" data-kid=\"1-3-1-4-5-3-1-2\" data-name=\"password input field\" id=\"reg-senha\" placeholder=\"Mínimo 3 caracteres\" type=\"password\"/>\n                        </div>\n                        <div class=\"field\" data-kid=\"1-3-1-4-5-3-2\" data-name=\"confirm password field container\">\n                            <label data-kid=\"1-3-1-4-5-3-2-1\" data-name=\"confirm password field label\" for=\"reg-confirma-senha\">\n                                Confirmar Senha\n                            </label>\n                            <input autocomplete=\"new-password\" data-kid=\"1-3-1-4-5-3-2-2\" data-name=\"confirm password input field\" id=\"reg-confirma-senha\" placeholder=\"Repita a senha\" type=\"password\"/>\n                        </div>\n                    </div>\n                    <button class=\"register-submit\" data-kid=\"1-3-1-4-5-4\" data-name=\"create account submit button\" type=\"button\">\n                        <span data-kid=\"1-3-1-4-5-4-1\" data-name=\"submit button label wrapper\">\n                            Forjar Conta de Aventureiro\n                        </span>\n                    </button>\n                    <p class=\"account-prompt\" data-kid=\"1-3-1-4-5-5\" data-name=\"existing account prompt text\">\n                        Já possui uma lenda registrada?\n                        <button data-kid=\"1-3-1-4-5-5-1\" data-name=\"go to existing account login button\" type=\"button\">\n                            Entrar com conta existente\n                        </button>\n                    </p>\n                </form>\n                <div aria-hidden=\"true\" class=\"threshold-glyphs\" data-kid=\"1-3-1-4-6\" data-name=\"threshold decorative glyph strip\">\n                    <img alt=\"\" data-kid=\"1-3-1-4-6-1\" data-name=\"templar shield glyph icon\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/templar-shield.svg\" style=\"color:var(--gold);width:27px;height:27px\"/>\n                    <img alt=\"\" data-kid=\"1-3-1-4-6-2\" data-name=\"powder bag glyph icon\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/powder-bag.svg\" style=\"color:var(--gold);width:27px;height:27px\"/>\n                    <img alt=\"\" data-kid=\"1-3-1-4-6-3\" data-name=\"winged emblem glyph icon\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/winged-emblem.svg\" style=\"color:var(--gold-bright);width:30px;height:30px\"/>\n                    <img alt=\"\" data-kid=\"1-3-1-4-6-4\" data-name=\"crossed swords glyph icon\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/crossed-swords.svg\" style=\"color:var(--gold);width:27px;height:27px\"/>\n                    <img alt=\"\" data-kid=\"1-3-1-4-6-5\" data-name=\"seven-pointed star glyph icon\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/seven-pointed-star.svg\" style=\"color:var(--gold);width:27px;height:27px\"/>\n                </div>\n                <span aria-hidden=\"true\" class=\"gate-footline\" data-kid=\"1-3-1-4-7\" data-name=\"gate bottom accent line\">\n                </span>\n            </div>\n        </section>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-10-11T15:38:25.328368+00:00",
      "modified": "2026-10-11T15:39:02.625198+00:00",
      "id": "var_e0bfdd0280a3",
      "contentHeight": 1142
    },
    "var_8aa17a2a0264": {
      "type": "variant",
      "label": "Living Emerald — login",
      "parentId": "var_06e85bff907a",
      "themeId": null,
      "rect": {
        "x": 4620,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n:root { --forest:#071a14; --iron:#101b19; --iron-deep:#081310; --stone:#3e493c; --moss:#427244; --gold:#c58a48; --gold-bright:#f3ce83; --parchment:#f4efe9; --muted:#c2c9bf; --font-title:'Cinzel', Georgia, serif; --font-body:'EB Garamond', Georgia, serif; }\n.gate-frame { position:relative; width:min(100%, 900px); min-height:824px; margin:18px auto 26px; padding:13px; clip-path:polygon(50% 0,56% 1%,63% 4%,70% 9%,78% 16%,87% 26%,95% 37%,100% 44%,100% 100%,0 100%,0 44%,5% 37%,13% 26%,22% 16%,30% 9%,37% 4%,44% 1%); background:linear-gradient(90deg,#56614a 0%,#304536 11%,#173328 22%,#11271e 78%,#36513a 90%,#62704c 100%); box-shadow:0 0 0 1px rgba(9,16,14,.9),0 22px 50px rgba(0,0,0,.55); }\n.gate-frame::before { content:''; position:absolute; inset:0; pointer-events:none; background:repeating-linear-gradient(0deg,transparent 0 92px,rgba(47,79,53,.24) 92px 95px,transparent 95px 183px); opacity:.56; }\n.gate-iron { position:relative; min-height:798px; clip-path:polygon(50% 0,56% 1%,63% 4%,70% 9%,78% 16%,87% 26%,95% 37%,100% 44%,100% 100%,0 100%,0 44%,5% 37%,13% 26%,22% 16%,30% 9%,37% 4%,44% 1%); padding:0 0 28px; background:linear-gradient(90deg,#0b1712 0%,#173326 13%,#12251b 25%,#10221a 75%,#183629 87%,#0a1510 100%); border:1px solid rgba(190,151,87,.42); }\n.gate-iron::before { content:''; position:absolute; inset:9px; pointer-events:none; border:1px solid rgba(192,158,94,.43); clip-path:polygon(50% 0,56% 1%,63% 4%,70% 9%,78% 16%,87% 26%,95% 37%,100% 44%,100% 100%,0 100%,0 44%,5% 37%,13% 26%,22% 16%,30% 9%,37% 4%,44% 1%); }\n.gate-content { position:relative; z-index:1; width:min(100% - 72px,590px); margin:0 auto; padding-top:80px; }\n.gate-header { text-align:center; padding:10px 14px 23px; border-bottom:1px solid rgba(201,151,77,.38); }\n.gate-header h1 { margin:13px 0 5px; font-family:var(--font-title); font-size:clamp(26px,3vw,37px); font-weight:600; letter-spacing:.035em; line-height:1.16; color:var(--gold-bright); }\n.gate-header p { margin:0; color:#e5d9bd; font:500 18px/1.35 var(--font-body); }\n.crest-box { width:50px; height:54px; margin:0 auto; display:grid; place-items:center; border:1px solid rgba(214,165,92,.78); background:linear-gradient(155deg,#294832,#111c14); box-shadow:inset 0 0 0 3px rgba(71,43,20,.28),0 1px 4px rgba(6,13,9,.48); }\n.tabs { display:grid; grid-template-columns:1fr 1fr; gap:8px; padding:12px 0 0; }\n.tab { min-height:48px; display:grid; place-items:center; font:600 15px/1.2 var(--font-title); letter-spacing:.055em; color:#bcc2b2; border:1px solid rgba(128,150,119,.58); background:linear-gradient(180deg,#394b3b,#28382d 48%,#1c2a21); box-shadow:inset 0 1px 0 rgba(222,232,199,.07); }\n.tab.active { color:#f5d58e; background:linear-gradient(180deg,#426046,#293f2e 52%,#1a2b20); border-color:rgba(214,169,97,.88); box-shadow:inset 0 2px 0 rgba(243,206,131,.44),inset 0 -2px 0 rgba(8,13,11,.64); }\n.auth-form { padding:24px 0 0; display:flex; flex-direction:column; gap:19px; }\n.field { display:flex; flex-direction:column; gap:8px; }\n.field label { color:#e6dfcc; font:600 15px/1.25 var(--font-title); letter-spacing:.035em; }\n.field input { width:100%; min-height:54px; padding:13px 17px; border:1px solid #6c776b; border-radius:2px; background:linear-gradient(180deg,#09140f,#0c1812); color:#f4efe9; font:italic 17px/1.2 var(--font-body); box-shadow:inset 0 2px 7px rgba(0,0,0,.46); }\n.field input::placeholder { color:#b4b9ac; opacity:.9; }\n.password-row { display:flex; align-items:center; justify-content:space-between; gap:12px; }\n.recovery-note { color:#e0bc71; font:500 15px/1.2 var(--font-body); text-decoration:underline; text-decoration-color:rgba(224,188,113,.65); text-underline-offset:3px; }\n.submit-wrap { position:relative; margin:10px 0 0 20px; }\n.submit-button { width:100%; min-height:66px; padding:10px 24px 10px 70px; border:1px solid #bb8d4c; border-radius:2px; color:#1c170e; background:linear-gradient(180deg,#f3d58e 0%,#dba95f 52%,#b88545 100%); font:700 18px/1.2 var(--font-title); letter-spacing:.035em; text-align:center; box-shadow:inset 0 1px 0 rgba(255,248,215,.5),inset 0 -2px 0 rgba(101,72,32,.24); }\n.seal { position:absolute; left:-23px; top:50%; transform:translateY(-50%); width:76px; height:76px; display:grid; place-items:center; border:2px solid #d1a35c; border-radius:50%; background:radial-gradient(circle at 36% 28%,#736441,#2b3826 63%,#101815); box-shadow:inset 0 0 0 4px #111814,inset 0 0 0 5px rgba(226,178,96,.72); }\n.seal img { width:43px; height:43px; object-fit:cover; border-radius:50%; filter:sepia(.12) saturate(1.1) brightness(1.06); }\n.switch-copy { margin:4px 0 0; text-align:center; color:#d0d0c1; font:500 16px/1.45 var(--font-body); }\n.switch-copy strong { color:#f3ce83; font-weight:600; text-decoration:underline; text-decoration-color:rgba(243,206,131,.65); text-underline-offset:3px; }\n.supabase-note { margin-top:7px; padding:12px 14px; border-top:1px solid rgba(194,151,76,.48); border-bottom:1px solid rgba(194,151,76,.28); color:#d1d1c4; font:400 14px/1.45 var(--font-body); }\n.supabase-note strong { display:block; margin-bottom:3px; color:#e6c67e; font:600 13px/1.35 var(--font-title); letter-spacing:.03em; }\n.glyph-foot { display:flex; justify-content:center; gap:36px; margin:22px auto 0; padding:16px 24px 0; width:min(100%,490px); border-top:1px solid rgba(164,152,115,.34); color:#c3ab73; }\n.glyph-foot i { display:inline-block; font-size:22px; line-height:1; color:#c4ad78; text-shadow:0 1px 0 #0a100d; }\n.glyph-foot img { width:24px; height:24px; object-fit:contain; filter:grayscale(.72) sepia(.48) saturate(1.25) brightness(1.03); opacity:.9; }\n@media (max-width:700px) { .gate-frame { min-height:100vh; margin:0 auto; padding:7px; clip-path:polygon(50% 0,60% 2%,71% 7%,83% 14%,93% 23%,100% 30%,100% 100%,0 100%,0 30%,7% 23%,17% 14%,29% 7%,40% 2%); } .gate-iron { min-height:100vh; padding-bottom:22px; clip-path:polygon(50% 0,60% 2%,71% 7%,83% 14%,93% 23%,100% 30%,100% 100%,0 100%,0 30%,7% 23%,17% 14%,29% 7%,40% 2%); } .gate-iron::before { inset:6px; clip-path:polygon(50% 0,60% 2%,71% 7%,83% 14%,93% 23%,100% 30%,100% 100%,0 100%,0 30%,7% 23%,17% 14%,29% 7%,40% 2%); } .gate-content { width:calc(100% - 38px); padding-top:94px; padding-bottom:20px; } .gate-header { padding-bottom:18px; } .gate-header h1 { font-size:clamp(22px,7vw,30px); } .gate-header p { font-size:17px; } .tabs { gap:6px; } .tab { font-size:13px; min-height:46px; } .auth-form { gap:17px; } .field label { font-size:14px; } .field input { min-height:52px; font-size:17px; } .password-row { align-items:flex-start; flex-direction:column; } .submit-wrap { margin-left:16px; } .submit-button { min-height:64px; padding-left:56px; font-size:15px; } .seal { width:66px; height:66px; left:-19px; } .seal img { width:37px; height:37px; } .glyph-foot { gap:23px; margin-top:22px; padding-inline:10px; } }\n/* Living Emerald material treatment: same architecture and same composition. */\n.relative.isolate > .fixed.inset-0 > img { filter:brightness(.78) saturate(1.28) contrast(1.04) sepia(.04); }\n.relative.isolate > .fixed.inset-0 > div:nth-of-type(1) { background:linear-gradient(180deg,rgba(5,19,12,.34),rgba(7,29,18,.56) 42%,rgba(5,15,11,.79)); }\n.relative.isolate > .fixed.inset-0 > div:nth-of-type(2) { background:linear-gradient(90deg,rgba(4,17,10,.39),transparent 27%,transparent 73%,rgba(4,17,10,.43)); }\n.gate-frame { background:linear-gradient(90deg,#586349 0%,#304832 11%,#173625 22%,#10251b 78%,#36533a 90%,#65724a 100%); }\n.gate-frame::before { background:repeating-linear-gradient(0deg,transparent 0 92px,rgba(65,104,59,.3) 92px 95px,transparent 95px 183px); opacity:.58; }\n.gate-iron { background:linear-gradient(90deg,#09160f 0%,#183a28 13%,#11271b 25%,#10251a 75%,#19402b 87%,#09150f 100%); border-color:rgba(201,153,78,.5); }\n.gate-iron::before { border-color:rgba(198,157,91,.5); }\n.gate-header { border-bottom-color:rgba(201,151,77,.42); }\n.crest-box { border-color:rgba(218,171,97,.82); background:linear-gradient(155deg,#31533a,#101a12); box-shadow:inset 0 0 0 3px rgba(74,48,21,.33),0 1px 4px rgba(6,13,9,.52); }\n.tab.active { background:linear-gradient(180deg,#466446,#2d442f 52%,#1b2e20); border-color:rgba(220,174,99,.9); }\n.field input { border-color:#647768; background:linear-gradient(180deg,#08130d,#0a160f); }\n.submit-button { border-color:#bf9252; background:linear-gradient(180deg,#f3d58f 0%,#dba85e 52%,#b98443 100%); }\n.supabase-note { border-top-color:rgba(198,154,78,.48); border-bottom-color:rgba(198,154,78,.3); }\n.glyph-foot { border-top-color:rgba(173,154,105,.4); color:#c9ae73; }\n@media (max-width:700px) { .relative.isolate > .fixed.inset-0 > img { filter:brightness(.74) saturate(1.2) contrast(1.04) sepia(.04); } }\n</style>\n<div class=\"relative isolate min-h-screen overflow-x-clip bg-[#091713] font-[var(--font-body)] text-[#f4efe9] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <div aria-hidden=\"true\" class=\"fixed inset-0 z-0\" data-kid=\"1-1\" data-name=\"background image layer\">\n        <img alt=\"Trilha de floresta em luz baixa, fotografia de Darya Karaliova no Unsplash.\" class=\"absolute inset-0 h-full w-full object-cover object-center opacity-65\" data-kid=\"1-1-1\" data-name=\"forest trail background photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1732135297799-0e4e29223e00?auto=format&w=1800&q=80&fit=crop\"/>\n        <div class=\"absolute inset-0 bg-[linear-gradient(180deg,rgba(5,12,10,.38),rgba(5,12,10,.62)_42%,rgba(5,12,10,.82))]\" data-kid=\"1-1-2\" data-name=\"vertical dark gradient overlay\">\n        </div>\n        <div class=\"absolute inset-0 bg-[linear-gradient(90deg,rgba(3,9,7,.45),transparent_27%,transparent_73%,rgba(3,9,7,.5))]\" data-kid=\"1-1-3\" data-name=\"horizontal dark edge gradient overlay\">\n        </div>\n    </div>\n    <main class=\"relative z-10 flex min-h-screen items-start justify-center px-3 py-0 md:items-center md:px-6 md:py-3\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-label=\"Portal dos Aventureiros\" class=\"gate-frame\" data-kid=\"1-2-1\" data-name=\"ornamental gate-frame portal container\">\n            <div class=\"gate-iron\" data-kid=\"1-2-1-1\" data-name=\"iron gate inner panel\">\n                <div class=\"gate-content\" data-kid=\"1-2-1-1-1\" data-name=\"gate content column\">\n                    <header class=\"gate-header\" data-kid=\"1-2-1-1-1-1\" data-name=\"gate portal header\">\n                        <div aria-hidden=\"true\" class=\"crest-box\" data-kid=\"1-2-1-1-1-1-1\" data-name=\"crest emblem frame\">\n                            <svg aria-hidden=\"true\" data-kid=\"1-2-1-1-1-1-1-1\" data-name=\"gold shield crest icon\" fill=\"none\" height=\"38\" viewbox=\"0 0 48 52\" width=\"34\">\n                                <path d=\"M24 2 44 9v14c0 14-8 22-20 27C12 45 4 37 4 23V9z\" fill=\"rgba(11, 19, 18, 0.9)\" stroke=\"rgba(240, 219, 162, 0.9)\" stroke-width=\"1.8\">\n                                </path>\n                                <path d=\"M24 10v32M14 18h20M15 30h18\" stroke=\"rgba(240, 219, 162, 0.9)\" stroke-linecap=\"round\" stroke-width=\"1.5\">\n                                </path>\n                                <circle cx=\"24\" cy=\"18\" fill=\"rgba(240, 219, 162, 0.95)\" r=\"2.5\">\n                                </circle>\n                            </svg>\n                        </div>\n                        <h1 data-kid=\"1-2-1-1-1-1-2\" data-name=\"portal title headline\">\n                            PORTAL DOS AVENTUREIROS\n                        </h1>\n                        <p data-kid=\"1-2-1-1-1-1-3\" data-name=\"portal tagline text\">\n                            ELEMENTUM — As crónicas começam aqui\n                        </p>\n                    </header>\n                    <div aria-label=\"Estado de autenticação\" class=\"tabs\" data-kid=\"1-2-1-1-1-2\" data-name=\"authentication mode tabs\">\n                        <div class=\"tab active\" data-kid=\"1-2-1-1-1-2-1\" data-name=\"login tab (active)\">\n                            ENTRAR\n                        </div>\n                        <div class=\"tab\" data-kid=\"1-2-1-1-1-2-2\" data-name=\"create account tab\">\n                            CRIAR CONTA\n                        </div>\n                    </div>\n                    <form aria-label=\"Entrar no Elementum\" class=\"auth-form\" data-kid=\"1-2-1-1-1-3\" data-name=\"login form\">\n                        <div class=\"field\" data-kid=\"1-2-1-1-1-3-1\" data-name=\"email field group\">\n                            <label data-kid=\"1-2-1-1-1-3-1-1\" data-name=\"email field label\" for=\"portal-email\">\n                                E-mail do Reino\n                            </label>\n                            <input autocomplete=\"email\" data-kid=\"1-2-1-1-1-3-1-2\" data-name=\"email input field\" id=\"portal-email\" placeholder=\"seu-email@reino.com\" type=\"email\"/>\n                        </div>\n                        <div class=\"field\" data-kid=\"1-2-1-1-1-3-2\" data-name=\"password field group\">\n                            <div class=\"password-row\" data-kid=\"1-2-1-1-1-3-2-1\" data-name=\"password label and recovery row\">\n                                <label data-kid=\"1-2-1-1-1-3-2-1-1\" data-name=\"password field label\" for=\"portal-password\">\n                                    Senha Arcana\n                                </label>\n                                <span class=\"recovery-note\" data-kid=\"1-2-1-1-1-3-2-1-2\" data-name=\"forgot password recovery link\">\n                                    Esqueceu sua senha?\n                                </span>\n                            </div>\n                            <input autocomplete=\"current-password\" data-kid=\"1-2-1-1-1-3-2-2\" data-name=\"password input field\" id=\"portal-password\" placeholder=\"Sua senha secreta\" type=\"password\"/>\n                        </div>\n                        <div class=\"submit-wrap\" data-kid=\"1-2-1-1-1-3-3\" data-name=\"submit button container with seal\">\n                            <button class=\"submit-button\" data-kid=\"1-2-1-1-1-3-3-1\" data-name=\"primary login call-to-action button\" type=\"button\">\n                                Adentrar ao Reino\n                            </button>\n                            <span aria-hidden=\"true\" class=\"seal\" data-kid=\"1-2-1-1-1-3-3-2\" data-name=\"circular wax seal badge\">\n                                <img alt=\"\" data-kid=\"1-2-1-1-1-3-3-2-1\" data-name=\"seal emblem image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/0087bbb4-ab33-4bd5-97ed-3ecab494db32/6121d9f3a402447e99deac3b71d8fd39.jpg\"/>\n                            </span>\n                        </div>\n                        <p class=\"switch-copy\" data-kid=\"1-2-1-1-1-3-4\" data-name=\"switch to signup prompt\">\n                            Novo nestas terras?\n                            <strong data-kid=\"1-2-1-1-1-3-4-1\" data-name=\"sign-up link\">\n                                Forjar uma nova conta\n                            </strong>\n                        </p>\n                        <div class=\"supabase-note\" data-kid=\"1-2-1-1-1-3-5\" data-name=\"Supabase connection note\">\n                            <strong data-kid=\"1-2-1-1-1-3-5-1\" data-name=\"Supabase note heading\">\n                                CONECTADO AO SUPABASE:\n                            </strong>\n                            As contas criadas são salvas e sincronizadas diretamente no seu projeto Supabase.\n                        </div>\n                    </form>\n                    <div aria-hidden=\"true\" class=\"glyph-foot\" data-kid=\"1-2-1-1-1-4\" data-name=\"footer glyph row\">\n                        <i class=\"ti ti-shield\" data-kid=\"1-2-1-1-1-4-1\" data-name=\"shield glyph icon\">\n                        </i>\n                        <i class=\"ti ti-moneybag\" data-kid=\"1-2-1-1-1-4-2\" data-name=\"money bag glyph icon\">\n                        </i>\n                        <img alt=\"\" data-kid=\"1-2-1-1-1-4-3\" data-name=\"decorative emblem image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/0087bbb4-ab33-4bd5-97ed-3ecab494db32/6121d9f3a402447e99deac3b71d8fd39.jpg\"/>\n                        <i class=\"ti ti-swords\" data-kid=\"1-2-1-1-1-4-4\" data-name=\"swords glyph icon\">\n                        </i>\n                        <i class=\"ti ti-star\" data-kid=\"1-2-1-1-1-4-5\" data-name=\"star glyph icon\">\n                        </i>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n</div>\n",
