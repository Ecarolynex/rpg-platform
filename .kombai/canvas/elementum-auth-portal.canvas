    "var_14287628c84d": {
      "type": "variant",
      "label": "03 · Open Inner Door — Login",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 15400,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=EB+Garamond:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n\n.portal-screen {\n  --ink: #091713;\n  --ink-panel: #102b28;\n  --parchment: #f4efe9;\n  --parchment-dim: #d9cdb9;\n  --gold: #c7a66c;\n  --gold-bright: #f0dba2;\n  --stone: #35423a;\n  --iron: #111a17;\n  --iron-edge: #59645b;\n  --muted: #c1c9c1;\n  min-height: 100svh;\n  position: relative;\n  isolation: isolate;\n  overflow-x: clip;\n  color: var(--parchment);\n  background: var(--ink);\n  font-family: 'EB Garamond', Georgia, serif;\n}\n.portal-screen * { box-sizing: border-box; }\n.portal-image { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: 50% 52%; opacity: .55; filter: brightness(.48) saturate(.72); }\n.portal-shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(4,12,10,.82), rgba(7,18,15,.53) 48%, rgba(4,12,10,.82)), linear-gradient(180deg, rgba(4,13,11,.38), rgba(4,13,11,.58)); }\n.stone-arch { padding: 10px; background: linear-gradient(145deg, #697469 0%, #39443b 11%, #202c26 52%, #414b40 100%); clip-path: polygon(50% 0, 100% 14%, 100% 100%, 0 100%, 0 14%); }\n.iron-reveal { padding: 7px; background: linear-gradient(145deg, #6a7168, #171e1b 17%, #252d27 72%, #717263); clip-path: polygon(50% 0, 100% 14%, 100% 100%, 0 100%, 0 14%); }\n.door-plane { min-height: 100%; padding: 82px 56px 26px; background: #12221e; clip-path: polygon(50% 0, 100% 14%, 100% 100%, 0 100%, 0 14%); }\n.door-header { max-width: 540px; margin-inline: auto; text-align: center; }\n.portal-heading { margin: 10px 0 2px; color: var(--gold-bright); font-family: 'Cinzel', Georgia, serif; font-size: clamp(17px, 1.75vw, 23px); line-height: 1.2; font-weight: 600; letter-spacing: .055em; }\n.portal-subtitle { color: var(--parchment-dim); font-size: 18px; font-style: italic; }\n.crest-frame { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border: 1px solid #837858; background: linear-gradient(145deg, #1c2c26, #0a1210); }\n.auth-tabs { display: grid; grid-template-columns: 1fr 1fr; max-width: 520px; margin: 22px auto 0; border: 1px solid #61665a; background: #101815; }\n.auth-tab { min-height: 48px; display: flex; align-items: center; justify-content: center; color: #b5b6a9; font-family: 'Cinzel', Georgia, serif; font-size: 14px; font-weight: 600; letter-spacing: .09em; border-right: 1px solid #444a41; }\n.auth-tab:last-child { border-right: 0; }\n.auth-tab.is-active { color: #f3dca1; background: linear-gradient(180deg, #394239, #222a24); box-shadow: inset 0 -2px #c7a66c; }\n.auth-form { width: min(100%, 456px); margin: 28px auto 0; display: flex; flex-direction: column; gap: 18px; }\n.auth-field { display: flex; flex-direction: column; gap: 7px; text-align: left; }\n.auth-label { color: #e0d9c8; font-size: 15px; font-weight: 600; letter-spacing: .025em; }\n.field-input { min-height: 50px; width: 100%; padding: 11px 15px; color: var(--parchment); background: #091511; border: 1px solid #6b7063; border-radius: 2px; font: 16px 'EB Garamond', Georgia, serif; }\n.field-input::placeholder { color: #a6aaa0; font-style: italic; opacity: 1; }\n.field-input:focus { outline: 2px solid #d7b975; outline-offset: 2px; }\n.password-line { display: flex; align-items: center; justify-content: space-between; gap: 10px; }\n.recovery-text { color: #e4ca8d; font-size: 14px; text-decoration: underline; text-decoration-color: #86734d; text-underline-offset: 3px; }\n.primary-auth { position: relative; display: flex; width: 100%; min-height: 83px; flex-direction: column; align-items: center; justify-content: flex-end; padding: 33px 20px 15px; margin-top: 14px; color: #17120a; background: linear-gradient(180deg, #e8d093, #c3a063); border: 1px solid #eeddaa; border-bottom: 4px solid #846c43; border-radius: 2px; font: 700 17px 'Cinzel', Georgia, serif; letter-spacing: .035em; box-shadow: inset 0 1px rgba(255,255,255,.32); }\n.phoenix-seal { position: absolute; top: -23px; left: 50%; width: 52px; height: 52px; transform: translateX(-50%); overflow: hidden; border: 2px solid #c7a66c; border-radius: 50%; background: #131816; }\n.phoenix-seal img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: center; }\n.switch-prompt { margin: 0; text-align: center; color: var(--muted); font-size: 16px; }\n.switch-prompt strong { color: #ead8aa; font-weight: 600; text-decoration: underline; text-decoration-color: #877750; text-underline-offset: 3px; }\n.supabase-note { margin-top: 4px; padding: 12px 14px; color: #d0d0c5; background: #17241f; border: 1px solid #51584c; font-size: 14px; line-height: 1.45; }\n.supabase-note strong { display: block; margin-bottom: 2px; color: #d4b779; font-family: 'Cinzel', Georgia, serif; font-size: 12px; letter-spacing: .04em; }\n.threshold-frieze { width: min(100%, 360px); min-height: 54px; display: flex; align-items: center; justify-content: space-evenly; margin: 14px auto 0; padding: 0 20px; color: #9ba49a; background: linear-gradient(180deg, #25302a, #111916); border: 1px solid #454d43; border-top: 2px solid #7b7763; }\n.threshold-frieze i { display: inline-flex; align-items: center; justify-content: center; font-size: 22px; line-height: 1; }\n.threshold-phoenix { display: inline-flex; width: 24px; height: 24px; overflow: hidden; border-radius: 50%; }\n.threshold-phoenix img { width: 100%; height: 100%; object-fit: cover; }\n@media (max-width: 640px) {\n  .portal-screen { min-height: 100svh; }\n  .portal-stage { padding: 12px 10px 18px; }\n  .stone-arch { padding: 5px; }\n  .iron-reveal { padding: 4px; }\n  .door-plane { padding: 70px 19px 24px; }\n  .portal-heading { max-width: 270px; margin-inline: auto; font-size: 16px; line-height: 1.35; }\n  .portal-subtitle { font-size: 16px; }\n  .crest-frame { width: 42px; height: 42px; }\n  .auth-tabs { margin-top: 18px; }\n  .auth-tab { min-height: 46px; font-size: 12px; }\n  .auth-form { margin-top: 24px; gap: 16px; }\n  .field-input { min-height: 48px; }\n  .primary-auth { min-height: 80px; font-size: 15px; }\n  .supabase-note { font-size: 13px; }\n  .threshold-frieze { width: min(100%, 330px); margin-top: 12px; }\n}\n</style>\n<div class=\"portal-screen\" data-kid=\"1\" data-name=\"portal sign-in screen\">\n    <img alt=\"A dark forest trail framed by layered trees, photograph by Alexey Demidov on Unsplash\" class=\"portal-image\" data-kid=\"1-1\" data-name=\"background forest trail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1644976914567-d830fcd4fec9?auto=format&w=1920&q=80&fit=crop\"/>\n    <div aria-hidden=\"true\" class=\"portal-shade\" data-kid=\"1-2\" data-name=\"dark overlay shade\">\n    </div>\n    <div class=\"portal-stage relative z-10 flex min-h-screen flex-col items-center justify-center px-6 py-5 md:py-6\" data-kid=\"1-3\" data-name=\"centered content stage\">\n        <section aria-label=\"Portal de autenticação Elementum\" class=\"stone-arch relative w-full max-w-[720px]\" data-kid=\"1-3-1\" data-name=\"decorative stone arch frame\">\n            <div class=\"iron-reveal\" data-kid=\"1-3-1-1\" data-name=\"iron reveal panel\">\n                <div class=\"door-plane\" data-kid=\"1-3-1-1-1\" data-name=\"door plane surface\">\n                    <header class=\"door-header\" data-kid=\"1-3-1-1-1-1\" data-name=\"header with crest and title\">\n                        <div aria-label=\"Brasão Elementum\" class=\"crest-frame\" data-kid=\"1-3-1-1-1-1-1\" data-name=\"coat of arms crest frame\">\n                            <svg aria-hidden=\"true\" data-kid=\"1-3-1-1-1-1-1-1\" data-name=\"shield crest icon\" fill=\"none\" height=\"35\" viewbox=\"0 0 48 52\" width=\"32\">\n                                <path d=\"M24 2 44 9v14c0 14-8 22-20 27C12 45 4 37 4 23V9z\" fill=\"rgba(11, 19, 18, 0.9)\" stroke=\"rgba(240, 219, 162, 0.9)\" stroke-width=\"1.8\">\n                                </path>\n                                <path d=\"M24 10v32M14 18h20M15 30h18\" stroke=\"rgba(240, 219, 162, 0.9)\" stroke-linecap=\"round\" stroke-width=\"1.5\">\n                                </path>\n                                <circle cx=\"24\" cy=\"18\" fill=\"rgba(240, 219, 162, 0.95)\" r=\"2.5\">\n                                </circle>\n                            </svg>\n                        </div>\n                        <h1 class=\"portal-heading\" data-kid=\"1-3-1-1-1-1-2\" data-name=\"main portal headline\">\n                            PORTAL DOS AVENTUREIROS\n                        </h1>\n                        <p class=\"portal-subtitle\" data-kid=\"1-3-1-1-1-1-3\" data-name=\"portal subtitle text\">\n                            ELEMENTUM — As crónicas começam aqui\n                        </p>\n                    </header>\n                    <div aria-label=\"Acesso à conta\" class=\"auth-tabs\" data-kid=\"1-3-1-1-1-2\" data-name=\"account access tabs\" role=\"tablist\">\n                        <div aria-selected=\"true\" class=\"auth-tab is-active\" data-kid=\"1-3-1-1-1-2-1\" data-name=\"sign in tab\" role=\"tab\">\n                            ENTRAR\n                        </div>\n                        <div aria-selected=\"false\" class=\"auth-tab\" data-kid=\"1-3-1-1-1-2-2\" data-name=\"create account tab\" role=\"tab\">\n                            CRIAR CONTA\n                        </div>\n                    </div>\n                    <form aria-label=\"Entrar no reino\" class=\"auth-form\" data-kid=\"1-3-1-1-1-3\" data-name=\"sign in form\">\n                        <div class=\"auth-field\" data-kid=\"1-3-1-1-1-3-1\" data-name=\"email field group\">\n                            <label class=\"auth-label\" data-kid=\"1-3-1-1-1-3-1-1\" data-name=\"email field label\" for=\"portal-email\">\n                                E-mail do Reino\n                            </label>\n                            <input autocomplete=\"email\" class=\"field-input\" data-kid=\"1-3-1-1-1-3-1-2\" data-name=\"email input field\" id=\"portal-email\" placeholder=\"seu-email@reino.com\" type=\"email\"/>\n                        </div>\n                        <div class=\"auth-field\" data-kid=\"1-3-1-1-1-3-2\" data-name=\"password field group\">\n                            <div class=\"password-line\" data-kid=\"1-3-1-1-1-3-2-1\" data-name=\"password label row\">\n                                <label class=\"auth-label\" data-kid=\"1-3-1-1-1-3-2-1-1\" data-name=\"password field label\" for=\"portal-password\">\n                                    Senha Arcana\n                                </label>\n                                <span class=\"recovery-text\" data-kid=\"1-3-1-1-1-3-2-1-2\" data-name=\"forgot password link text\">\n                                    Esqueceu sua senha?\n                                </span>\n                            </div>\n                            <input autocomplete=\"current-password\" class=\"field-input\" data-kid=\"1-3-1-1-1-3-2-2\" data-name=\"password input field\" id=\"portal-password\" placeholder=\"Sua senha secreta\" type=\"password\"/>\n                        </div>\n                        <button aria-label=\"Adentrar ao Reino\" class=\"primary-auth\" data-kid=\"1-3-1-1-1-3-3\" data-name=\"primary sign-in button\" type=\"button\">\n                            <span class=\"phoenix-seal\" data-kid=\"1-3-1-1-1-3-3-1\" data-name=\"phoenix seal badge\">\n                                <img alt=\"Selo circular de fênix em metal dourado e ferro\" data-kid=\"1-3-1-1-1-3-3-1-1\" data-name=\"phoenix seal image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/0087bbb4-ab33-4bd5-97ed-3ecab494db32/b33ec6296acf474eb013549bef8982f4.jpg\"/>\n                            </span>\n                            <span data-kid=\"1-3-1-1-1-3-3-2\" data-name=\"button label text\">\n                                Adentrar ao Reino\n                            </span>\n                        </button>\n                        <p class=\"switch-prompt\" data-kid=\"1-3-1-1-1-3-4\" data-name=\"new user prompt\">\n                            Novo nestas terras?\n                            <strong data-kid=\"1-3-1-1-1-3-4-1\" data-name=\"forage new account link\">\n                                Forjar uma nova conta\n                            </strong>\n                        </p>\n                        <aside aria-label=\"Informação de conexão\" class=\"supabase-note\" data-kid=\"1-3-1-1-1-3-5\" data-name=\"supabase connection note box\">\n                            <strong data-kid=\"1-3-1-1-1-3-5-1\" data-name=\"note title text\">\n                                CONECTADO AO SUPABASE:\n                            </strong>\n                            As contas criadas são salvas e sincronizadas diretamente no seu projeto Supabase.\n                        </aside>\n                    </form>\n                </div>\n            </div>\n        </section>\n        <div aria-hidden=\"true\" class=\"threshold-frieze\" data-kid=\"1-3-2\" data-name=\"decorative threshold frieze\">\n            <i aria-hidden=\"true\" class=\"ti ti-shield\" data-kid=\"1-3-2-1\" data-name=\"shield icon\">\n            </i>\n            <i aria-hidden=\"true\" class=\"ti ti-shopping-bag\" data-kid=\"1-3-2-2\" data-name=\"shopping bag icon\">\n            </i>\n            <span class=\"threshold-phoenix\" data-kid=\"1-3-2-3\" data-name=\"phoenix mini icon wrapper\">\n                <img alt=\"\" data-kid=\"1-3-2-3-1\" data-name=\"phoenix mini icon image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/0087bbb4-ab33-4bd5-97ed-3ecab494db32/b33ec6296acf474eb013549bef8982f4.jpg\"/>\n            </span>\n            <i aria-hidden=\"true\" class=\"ti ti-swords\" data-kid=\"1-3-2-4\" data-name=\"swords icon\">\n            </i>\n            <i aria-hidden=\"true\" class=\"ti ti-star\" data-kid=\"1-3-2-5\" data-name=\"star icon\">\n            </i>\n        </div>\n    </div>\n</div>\n",
