    "var_1dbd4a594527": {
      "type": "variant",
      "label": "Turquoise Patina — register style",
      "parentId": "var_8b8c971c2455",
      "themeId": null,
      "rect": {
        "x": 10780,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n.intact-page{--ink:#091713;--deep:#0d1715;--panel:#102b28;--panel-raised:#1a3d39;--parchment:#f4efe9;--parchment-dim:#d9cdb9;--gold:#c7a66c;--gold-bright:#f0dba2;--forest:#174d48;--muted:#a8b3ae;--stone:#393a32;--iron:#111714;--line:rgba(199,166,108,.5);--display:'Cinzel',Georgia,serif;--body:'EB Garamond',Georgia,serif;position:relative;min-height:100vh;isolation:isolate;overflow-x:clip;background:var(--ink);color:var(--parchment);font-family:var(--body);font-size:18px;line-height:1.45}\n.intact-page *{box-sizing:border-box}\n.forest-image{position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;object-position:center 54%;z-index:-3;filter:brightness(.43) saturate(.65) contrast(1.08)}\n.forest-shade{position:absolute;inset:0;z-index:-2;background:linear-gradient(180deg,rgba(5,12,10,.62),rgba(7,18,15,.78) 45%,rgba(5,12,10,.9)),linear-gradient(90deg,rgba(4,12,10,.68),transparent 23%,transparent 77%,rgba(4,12,10,.68))}\n.page-grain{display:none}\n.portal-stage{min-height:100vh;display:flex;align-items:flex-start;justify-content:center;padding:26px 22px 22px;position:relative}\n.gate-outer{position:relative;width:min(100%,760px);min-height:1100px;clip-path:polygon(0 100%,0 16%,47.4% 0,52.6% 0,100% 16%,100% 100%);padding:13px;background:linear-gradient(130deg,#505049 0%,#262b26 15%,#4c4b3e 22%,#191f1c 30%,#35372f 48%,#171e1a 67%,#45483b 80%,#1b211c 100%);filter:drop-shadow(0 22px 32px rgba(0,0,0,.5))}\n.stone-material{position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;object-position:center;opacity:.31;mix-blend-mode:screen;filter:grayscale(.84) brightness(.54) contrast(1.35);pointer-events:none}\n.stone-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(9,16,13,.32),rgba(9,16,13,.08) 14%,rgba(9,16,13,.08) 86%,rgba(9,16,13,.32)),linear-gradient(180deg,rgba(12,18,14,.12),rgba(8,15,12,.6));pointer-events:none}\n.masonry-joints{position:absolute;inset:0;opacity:.45;pointer-events:none;background:linear-gradient(90deg,transparent 11.5%,rgba(188,178,142,.22) 11.65%,transparent 11.85%,transparent 88%,rgba(188,178,142,.22) 88.15%,transparent 88.35%),linear-gradient(180deg,transparent 22%,rgba(188,178,142,.18) 22.2%,transparent 22.4%,transparent 39%,rgba(188,178,142,.15) 39.2%,transparent 39.4%,transparent 61%,rgba(188,178,142,.13) 61.2%,transparent 61.4%)}\n.gate-inner{position:relative;min-height:1074px;clip-path:polygon(0 100%,0 16.6%,47.5% 1.6%,52.5% 1.6%,100% 16.6%,100% 100%);background:linear-gradient(180deg,#111a16 0%,#101a17 28%,#0f1b17 100%);border:1px solid rgba(235,222,186,.24);overflow:hidden}\n.gate-inner:before{content:\"\";position:absolute;inset:0;clip-path:polygon(1.2% 100%,1.2% 17.4%,47.7% 2.8%,52.3% 2.8%,98.8% 17.4%,98.8% 100%);border:1px solid rgba(218,206,168,.34);pointer-events:none}\n.gate-inner:after{content:\"\";position:absolute;inset:10px;clip-path:polygon(0 100%,0 16.5%,47.4% 0,52.6% 0,100% 16.5%,100% 100%);border:1px solid rgba(0,0,0,.72);pointer-events:none}\n.gate-moss{position:absolute;top:19%;bottom:5%;width:28px;pointer-events:none;opacity:.67;background:linear-gradient(180deg,transparent 0%,rgba(55,75,48,.76) 24%,rgba(43,66,43,.44) 34%,transparent 46%,rgba(57,72,42,.66) 66%,transparent 83%);filter:saturate(.6)}\n.gate-moss.left{left:11px;clip-path:polygon(0 0,100% 8%,66% 23%,100% 32%,43% 48%,75% 59%,30% 73%,62% 90%,0 100%)}\n.gate-moss.right{right:11px;clip-path:polygon(100% 0,0 8%,34% 23%,0 32%,57% 48%,25% 59%,70% 73%,38% 90%,100% 100%)}\n.portal-content{position:relative;z-index:2;width:min(100%,566px);margin:0 auto}\n.portal-heading{text-align:center;padding:144px 20px 20px;border-bottom:1px solid rgba(199,166,108,.28)}\n.brand-mark{width:56px;height:60px;margin:0 auto 13px;display:grid;place-items:center;border:1px solid rgba(199,166,108,.55);background:linear-gradient(155deg,#1b2c25,#0c1512);box-shadow:inset 0 0 0 3px rgba(0,0,0,.22)}\n.brand-mark svg{width:36px;height:39px;display:block}\n.portal-heading h1{margin:0;color:var(--gold-bright);font-family:var(--display);font-size:clamp(22px,3vw,29px);font-weight:600;letter-spacing:.105em;line-height:1.25;text-transform:uppercase}\n.portal-heading p{margin:9px 0 0;color:#e0d4bb;font-family:var(--body);font-size:19px;letter-spacing:.012em}\n.portal-tabs{display:grid;grid-template-columns:1fr 1fr;margin:23px 0 25px;padding:0;border:1px solid rgba(174,161,126,.55);background:#111a17}\n.portal-tab{min-height:53px;padding:13px 10px;border:0;background:linear-gradient(180deg,#252923,#1c211d);color:#b8b5a8;font-family:var(--display);font-size:14px;font-weight:600;letter-spacing:.105em;text-transform:uppercase}\n.portal-tab + .portal-tab{border-left:1px solid rgba(199,166,108,.26)}\n.portal-tab.active{position:relative;background:linear-gradient(180deg,#394036,#283128);color:var(--gold-bright);box-shadow:inset 0 3px 0 rgba(240,219,162,.56),inset 0 -3px 0 rgba(0,0,0,.58)}\n.portal-tab.active:after{content:\"\";position:absolute;inset:4px;border:1px solid rgba(240,219,162,.16);pointer-events:none}\n.register-form{display:flex;flex-direction:column;gap:20px;padding:0 20px 30px}\n.field{display:flex;flex-direction:column;gap:8px;min-width:0}\n.field label{color:#e3d9c6;font-family:var(--display);font-size:13px;font-weight:500;letter-spacing:.045em;line-height:1.45}\n.field input{display:block;width:100%;min-height:50px;padding:12px 15px;border:1px solid rgba(203,193,163,.48);border-radius:2px;background:linear-gradient(180deg,#09120f,#0b1512);box-shadow:inset 0 2px 3px rgba(0,0,0,.3);color:var(--parchment);font-family:var(--body);font-size:18px;line-height:1.35}\n.field input::placeholder{color:#a9aaa0;font-family:var(--body);font-size:16px;font-style:italic;opacity:.9}\n.field input:focus{outline:2px solid var(--gold-bright);outline-offset:2px;border-color:var(--gold-bright)}\n.password-grid{display:grid;grid-template-columns:1fr 1fr;gap:17px}\n.register-submit{width:100%;min-height:60px;margin-top:3px;padding:14px 18px;border:1px solid #9b7943;border-radius:2px;background:linear-gradient(180deg,#f0dba2 0%,#d4b572 55%,#b99250 100%);color:#16130d;font-family:var(--display);font-size:16px;font-weight:700;letter-spacing:.075em;text-transform:uppercase;box-shadow:inset 0 1px rgba(255,255,255,.42),inset 0 -2px rgba(74,49,19,.24)}\n.register-submit span{display:inline-flex;align-items:center;justify-content:center;min-height:28px}\n.account-prompt{margin:3px 0 0;text-align:center;color:#c3c1b5;font-size:16px}\n.account-prompt button{padding:0;border:0;background:transparent;color:var(--gold-bright);font:inherit;font-weight:600;text-decoration:underline;text-decoration-color:rgba(240,219,162,.62);text-underline-offset:4px}\n.threshold-glyphs{position:absolute;z-index:3;left:50%;bottom:31px;transform:translateX(-50%);width:min(530px,76%);display:flex;align-items:center;justify-content:space-between;padding:15px 27px 10px;border-top:1px solid rgba(199,166,108,.38);border-bottom:1px solid rgba(199,166,108,.2);color:#cfbc8b;pointer-events:none}\n.threshold-glyphs img{display:block;width:27px;height:27px;max-width:none;object-fit:contain;color:#c4b487;opacity:.92;filter:brightness(0) saturate(100%) invert(79%) sepia(25%) saturate(412%) hue-rotate(7deg) brightness(92%) contrast(90%)}\n.threshold-glyphs img:nth-child(3){width:30px;height:30px;color:var(--gold-bright);opacity:1}\n.gate-footline{position:absolute;bottom:17px;left:50%;width:48%;height:1px;transform:translateX(-50%);background:linear-gradient(90deg,transparent,rgba(199,166,108,.42),transparent)}\n@media (min-width:900px){.portal-stage{padding-top:20px}}\n@media (max-width:700px){.portal-stage{padding:10px 8px 14px}.gate-outer{width:100%;min-height:1140px;padding:9px}.gate-inner{min-height:1122px}.portal-heading{padding:120px 20px 18px}.register-form{padding:0 20px 36px}.gate-moss{width:15px}.gate-moss.left{left:8px}.gate-moss.right{right:8px}.threshold-glyphs{width:85%;bottom:31px;padding:13px 18px 9px}.threshold-glyphs img{width:23px;height:23px}.threshold-glyphs img:nth-child(3){width:26px;height:26px}.portal-heading p{font-size:17px}}\n@media (max-width:470px){.portal-content{padding:104px 17px 40px}.portal-heading{padding-bottom:17px}.portal-heading h1{font-size:20px;letter-spacing:.07em}.portal-heading p{font-size:16px}.portal-tabs{margin:19px 0 21px}.portal-tab{min-height:48px;font-size:12px;letter-spacing:.08em}.register-form{gap:17px}.password-grid{grid-template-columns:1fr;gap:17px}.field label{font-size:12px}.field input{min-height:48px;font-size:17px}.register-submit{font-size:14px;letter-spacing:.045em}.account-prompt{font-size:15px}.threshold-glyphs{width:88%;padding-inline:14px}}\n/* Style-only material color pass: subtle teal mineral reflections with preserved layout and readability. */\n.forest-image{filter:brightness(.49) saturate(.9) contrast(1.06)}\n.gate-outer{background:linear-gradient(130deg,#4e625a 0%,#263b35 15%,#526454 22%,#142a25 30%,#394b3e 48%,#142822 67%,#50624e 80%,#173129 100%)}\n.stone-material{opacity:.37;filter:grayscale(.64) brightness(.56) contrast(1.28) saturate(1.16)}\n.stone-shade{background:linear-gradient(90deg,rgba(6,33,31,.34),rgba(10,30,26,.08) 14%,rgba(10,30,26,.08) 86%,rgba(6,33,31,.34)),linear-gradient(180deg,rgba(12,31,25,.12),rgba(8,24,22,.56)),linear-gradient(0deg,rgba(28,117,113,.18),transparent 17%,transparent 82%,rgba(177,133,67,.08))}\n.masonry-joints{opacity:.55;background:linear-gradient(90deg,transparent 11.5%,rgba(91,157,140,.27) 11.65%,transparent 11.85%,transparent 88%,rgba(91,157,140,.27) 88.15%,transparent 88.35%),linear-gradient(180deg,transparent 22%,rgba(113,166,140,.21) 22.2%,transparent 22.4%,transparent 39%,rgba(95,157,137,.19) 39.2%,transparent 39.4%,transparent 61%,rgba(75,142,131,.18) 61.2%,transparent 61.4%)}\n.gate-inner{background:linear-gradient(180deg,#10231e 0%,#0e211d 28%,#0d201d 100%);border-color:rgba(112,172,150,.31)}\n.gate-inner:before{border-color:rgba(92,165,148,.36)}\n.gate-inner:after{border-color:rgba(0,0,0,.72)}\n.gate-moss{opacity:.78;background:linear-gradient(180deg,transparent 0%,rgba(48,101,64,.82) 24%,rgba(42,89,62,.54) 34%,transparent 46%,rgba(63,103,58,.73) 66%,transparent 83%);filter:saturate(.94)}\n.brand-mark{border-color:rgba(204,159,92,.76);background:linear-gradient(155deg,#285247,#10231f);box-shadow:inset 0 0 0 3px rgba(0,0,0,.24),inset 0 0 0 4px rgba(73,151,140,.18)}\n.portal-tabs{border-color:rgba(108,166,147,.52);background:#10231f}\n.portal-tab{background:linear-gradient(180deg,#1d3d36,#142b27);color:#c8d4c9}\n.portal-tab + .portal-tab{border-left-color:rgba(108,166,147,.32)}\n.portal-tab.active{background:linear-gradient(180deg,#31594c,#1b3932);color:#f0dba2;box-shadow:inset 0 3px 0 rgba(225,185,109,.76),inset 0 -3px 0 rgba(0,0,0,.58)}\n.portal-tab.active:after{border-color:rgba(240,219,162,.22)}\n.register-submit{border-color:#bd9251;background:linear-gradient(180deg,#f3d999 0%,#dfbc74 55%,#bd9658 100%);box-shadow:inset 0 1px rgba(255,248,215,.5),inset 0 -2px rgba(74,49,19,.24),0 0 0 1px rgba(64,146,131,.34)}\n.threshold-glyphs{border-top-color:rgba(93,163,144,.43);border-bottom-color:rgba(199,166,108,.28);color:#d3be8d}\n.gate-footline{background:linear-gradient(90deg,transparent,rgba(96,167,145,.4),rgba(199,166,108,.42),transparent)}\n</style>\n<div class=\"intact-page min-h-screen w-full\" data-kid=\"1\" data-name=\"page layout container\">\n    <img alt=\"Trilha em uma floresta temperada, fotografia de Julia Perera no Unsplash.\" class=\"forest-image\" data-kid=\"1-1\" data-name=\"background forest trail photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1722654331197-fbb2ff8edf62?auto=format&w=2000&q=80&fit=crop\"/>\n    <div aria-hidden=\"true\" class=\"forest-shade\" data-kid=\"1-2\" data-name=\"background shading overlay\">\n    </div>\n    <main class=\"portal-stage\" data-kid=\"1-3\" data-name=\"portal authentication stage\">\n        <section aria-label=\"Portal de autenticação Elementum\" class=\"gate-outer\" data-kid=\"1-3-1\" data-name=\"gate authentication panel\">\n            <img alt=\"Ruínas de pedra cobertas por vegetação, fotografia de Sergii Ruchko no Unsplash.\" class=\"stone-material\" data-kid=\"1-3-1-1\" data-name=\"gate stone texture overlay image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1778265731135-a09dbac07173?auto=format&w=1100&q=78&fit=crop\"/>\n            <div aria-hidden=\"true\" class=\"stone-shade\" data-kid=\"1-3-1-2\" data-name=\"gate stone shading overlay\">\n            </div>\n            <div aria-hidden=\"true\" class=\"masonry-joints\" data-kid=\"1-3-1-3\" data-name=\"gate masonry joint line overlay\">\n            </div>\n            <div class=\"gate-inner\" data-kid=\"1-3-1-4\" data-name=\"inner gate content frame\">\n                <span aria-hidden=\"true\" class=\"gate-moss left\" data-kid=\"1-3-1-4-1\" data-name=\"left decorative moss strip\">\n                </span>\n                <span aria-hidden=\"true\" class=\"gate-moss right\" data-kid=\"1-3-1-4-2\" data-name=\"right decorative moss strip\">\n                </span>\n                <header class=\"portal-content portal-heading\" data-kid=\"1-3-1-4-3\" data-name=\"portal heading area\">\n                    <div aria-label=\"Brasão Elementum\" class=\"brand-mark\" data-kid=\"1-3-1-4-3-1\" data-name=\"brand crest badge\">\n                        <svg aria-label=\"Crest Elementum\" data-kid=\"1-3-1-4-3-1-1\" data-name=\"crest emblem icon\" fill=\"none\" role=\"img\" viewbox=\"0 0 48 52\">\n                            <path d=\"M24 2 44 9v14c0 14-8 22-20 27C12 45 4 37 4 23V9z\" fill=\"#0b1312\" stroke=\"#f0dba2\" stroke-width=\"1.8\">\n                            </path>\n                            <path d=\"M24 10v32M14 18h20M15 30h18\" stroke=\"#f0dba2\" stroke-linecap=\"round\" stroke-width=\"1.5\">\n                            </path>\n                            <circle cx=\"24\" cy=\"18\" fill=\"#f0dba2\" r=\"2.5\">\n                            </circle>\n                        </svg>\n                    </div>\n                    <h1 data-kid=\"1-3-1-4-3-2\" data-name=\"portal headline text\">\n                        Portal dos Aventureiros\n                    </h1>\n                    <p data-kid=\"1-3-1-4-3-3\" data-name=\"portal tagline text\">\n                        ELEMENTUM — As crónicas começam aqui\n                    </p>\n                </header>\n                <nav aria-label=\"Autenticação\" class=\"portal-content portal-tabs\" data-kid=\"1-3-1-4-4\" data-name=\"authentication mode tab bar\">\n                    <button aria-selected=\"false\" class=\"portal-tab\" data-kid=\"1-3-1-4-4-1\" data-name=\"login tab button\" type=\"button\">\n                        Entrar\n                    </button>\n                    <button aria-selected=\"true\" class=\"portal-tab active\" data-kid=\"1-3-1-4-4-2\" data-name=\"create account tab button (active)\" type=\"button\">\n                        Criar conta\n                    </button>\n                </nav>\n                <form aria-label=\"Criar conta\" class=\"portal-content register-form\" data-kid=\"1-3-1-4-5\" data-name=\"create account form\">\n                    <div class=\"field\" data-kid=\"1-3-1-4-5-1\" data-name=\"username field container\">\n                        <label data-kid=\"1-3-1-4-5-1-1\" data-name=\"username field label\" for=\"reg-usuario\">\n                            Nome de Aventureiro (Usuário)\n                        </label>\n                        <input autocomplete=\"username\" data-kid=\"1-3-1-4-5-1-2\" data-name=\"username text input field\" id=\"reg-usuario\" placeholder=\"Ex: MagoEldrin, Valquíria...\" type=\"text\"/>\n                    </div>\n                    <div class=\"field\" data-kid=\"1-3-1-4-5-2\" data-name=\"email field container\">\n                        <label data-kid=\"1-3-1-4-5-2-1\" data-name=\"email field label\" for=\"reg-email\">\n                            E-mail do Reino\n                        </label>\n                        <input autocomplete=\"email\" data-kid=\"1-3-1-4-5-2-2\" data-name=\"email text input field\" id=\"reg-email\" placeholder=\"aventureiro@reino.com\" type=\"email\"/>\n                    </div>\n                    <div class=\"password-grid\" data-kid=\"1-3-1-4-5-3\" data-name=\"password fields grid container\">\n                        <div class=\"field\" data-kid=\"1-3-1-4-5-3-1\" data-name=\"password field container\">\n                            <label data-kid=\"1-3-1-4-5-3-1-1\" data-name=\"password field label\" for=\"reg-senha\">\n                                Senha\n                            </label>\n                            <input autocomplete=\"new-password\" data-kid=\"1-3-1-4-5-3-1-2\" data-name=\"password input field\" id=\"reg-senha\" placeholder=\"Mínimo 3 caracteres\" type=\"password\"/>\n                        </div>\n                        <div class=\"field\" data-kid=\"1-3-1-4-5-3-2\" data-name=\"confirm password field container\">\n                            <label data-kid=\"1-3-1-4-5-3-2-1\" data-name=\"confirm password field label\" for=\"reg-confirma-senha\">\n                                Confirmar Senha\n                            </label>\n                            <input autocomplete=\"new-password\" data-kid=\"1-3-1-4-5-3-2-2\" data-name=\"confirm password input field\" id=\"reg-confirma-senha\" placeholder=\"Repita a senha\" type=\"password\"/>\n                        </div>\n                    </div>\n                    <button class=\"register-submit\" data-kid=\"1-3-1-4-5-4\" data-name=\"create account submit button\" type=\"button\">\n                        <span data-kid=\"1-3-1-4-5-4-1\" data-name=\"submit button label wrapper\">\n                            Forjar Conta de Aventureiro\n                        </span>\n                    </button>\n                    <p class=\"account-prompt\" data-kid=\"1-3-1-4-5-5\" data-name=\"existing account prompt text\">\n                        Já possui uma lenda registrada?\n                        <button data-kid=\"1-3-1-4-5-5-1\" data-name=\"go to existing account login button\" type=\"button\">\n                            Entrar com conta existente\n                        </button>\n                    </p>\n                </form>\n                <div aria-hidden=\"true\" class=\"threshold-glyphs\" data-kid=\"1-3-1-4-6\" data-name=\"threshold decorative glyph strip\">\n                    <img alt=\"\" data-kid=\"1-3-1-4-6-1\" data-name=\"templar shield glyph icon\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/templar-shield.svg\" style=\"color:var(--gold);width:27px;height:27px\"/>\n                    <img alt=\"\" data-kid=\"1-3-1-4-6-2\" data-name=\"powder bag glyph icon\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/powder-bag.svg\" style=\"color:var(--gold);width:27px;height:27px\"/>\n                    <img alt=\"\" data-kid=\"1-3-1-4-6-3\" data-name=\"winged emblem glyph icon\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/winged-emblem.svg\" style=\"color:var(--gold-bright);width:30px;height:30px\"/>\n                    <img alt=\"\" data-kid=\"1-3-1-4-6-4\" data-name=\"crossed swords glyph icon\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/crossed-swords.svg\" style=\"color:var(--gold);width:27px;height:27px\"/>\n                    <img alt=\"\" data-kid=\"1-3-1-4-6-5\" data-name=\"seven-pointed star glyph icon\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/seven-pointed-star.svg\" style=\"color:var(--gold);width:27px;height:27px\"/>\n                </div>\n                <span aria-hidden=\"true\" class=\"gate-footline\" data-kid=\"1-3-1-4-7\" data-name=\"gate bottom accent line\">\n                </span>\n            </div>\n        </section>\n    </main>\n</div>\n",
