      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n.gatehouse-page{--ink:#091713;--iron:#101b18;--iron-raised:#1b2421;--stone:#4e5046;--stone-light:#706c59;--moss:#364a3b;--gold:#c7a66c;--gold-light:#f0dba2;--parchment:#f4efe9;--muted:#c0c5bc;min-height:100vh;position:relative;isolation:isolate;display:flex;align-items:center;justify-content:center;padding:38px 30px;color:var(--parchment);font-family:'EB Garamond',Georgia,serif;background:#091713;overflow-x:clip}.gatehouse-page *{box-sizing:border-box}.forest-backdrop{position:absolute;z-index:-3;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 54%;filter:brightness(.43) saturate(.72)}.forest-shade{position:absolute;z-index:-2;inset:0;background:linear-gradient(90deg,rgba(5,13,11,.68),rgba(7,17,14,.31) 24%,rgba(7,17,14,.28) 75%,rgba(5,13,11,.72)),linear-gradient(180deg,rgba(7,15,13,.68),rgba(8,18,15,.28) 34%,rgba(5,13,11,.73))}.gatehouse-shell{position:relative;width:min(100%,1020px);margin:auto;isolation:isolate}.lintel{position:relative;min-height:126px;padding:17px 34px 18px;background:linear-gradient(180deg,#33372f 0%,#1d2521 27%,#111a17 100%);border:2px solid #655e4b;border-bottom:5px solid #786844;box-shadow:inset 0 1px 0 rgba(238,224,184,.2),0 9px 0 #111815}.lintel:before,.lintel:after{content:'';position:absolute;top:7px;width:8px;height:calc(100% - 18px);background:linear-gradient(180deg,#8b7952,#3a3b32 18%,#4f5046 82%,#84724c);opacity:.72}.lintel:before{left:10px}.lintel:after{right:10px}.lintel-content{position:relative;text-align:center}.lintel-title{margin:0 0 8px;font-family:'Cinzel',Georgia,serif;font-size:16px;font-weight:700;line-height:1.2;letter-spacing:.14em;color:#ead9ae;text-shadow:0 1px 2px #070d0a}.brand-row{display:flex;align-items:center;justify-content:center;gap:13px}.brand-crest{width:46px;height:48px;flex:none;filter:drop-shadow(0 1px 2px rgba(0,0,0,.75))}.brand-subtitle{margin:0;color:#f1e8d1;font-family:'Cinzel',Georgia,serif;font-weight:600;letter-spacing:.035em;font-size:16px}.gatehouse-body{display:grid;grid-template-columns:96px minmax(0,1fr) 96px;align-items:stretch;border-left:2px solid #655e4b;border-right:2px solid #655e4b;background:#0a1411}.stone-pier{position:relative;min-height:510px;background:linear-gradient(90deg,#30352e 0%,#57574a 15%,#41443a 41%,#30372f 77%,#202924 100%);border-inline:5px solid #202823;box-shadow:inset 0 0 0 1px rgba(180,159,108,.17),inset 8px 0 13px rgba(0,0,0,.22)}.stone-pier:before{content:'';position:absolute;inset:12px 9px;background:linear-gradient(180deg,rgba(120,132,91,.2),transparent 22%,transparent 77%,rgba(55,83,55,.18));border-inline:1px solid rgba(207,190,145,.13)}.stone-pier:after{content:'';position:absolute;top:0;bottom:0;left:50%;width:1px;background:linear-gradient(180deg,rgba(224,206,159,.12),transparent 27%,rgba(0,0,0,.2) 70%,rgba(176,155,105,.14));transform:translateX(-50%)}.pier-cap{height:23px;background:linear-gradient(180deg,#77705a,#3b4037 60%,#242b26);border-bottom:2px solid #9a8052;box-shadow:0 3px 5px rgba(0,0,0,.45)}.pier-blocks{position:absolute;inset:30px 8px 18px;display:flex;flex-direction:column;justify-content:space-between}.pier-joint{height:1px;background:rgba(9,16,13,.46);box-shadow:0 1px rgba(206,191,149,.08)}.pier-stud{position:absolute;left:50%;width:9px;height:9px;border-radius:50%;transform:translateX(-50%);background:radial-gradient(circle at 36% 30%,#b39a62,#615942 48%,#242a24 74%);border:1px solid #988359;box-shadow:0 1px 2px #050a08}.pier-stud.top{top:39px}.pier-stud.bottom{bottom:27px}.gatehouse-opening{min-width:0;background:#0c1714}.stone-tabs{display:grid;grid-template-columns:1fr 1fr;gap:4px;padding:9px 13px 0;background:linear-gradient(180deg,#30352e,#171e1b);border-bottom:2px solid #746340}.stone-tab{min-height:52px;display:flex;align-items:center;justify-content:center;border:1px solid #5c5b4a;background:linear-gradient(180deg,#555648,#373d35);color:#d8d1bd;font-family:'Cinzel',Georgia,serif;font-size:14px;font-weight:600;letter-spacing:.13em;text-shadow:0 1px 2px #111;box-shadow:inset 0 1px rgba(239,225,186,.15);cursor:default}.stone-tab.is-active{color:#f4e4b6;background:linear-gradient(180deg,#333d35,#18231e);border-color:#ae9258;box-shadow:inset 0 2px 0 rgba(226,194,120,.55),inset 0 1px 0 rgba(255,255,255,.09)}.writing-surface{position:relative;min-height:446px;padding:24px 34px 19px;background:#101b18;border-inline:1px solid #36433b}.writing-surface:before{content:'';position:absolute;inset:10px 9px;pointer-events:none;border:1px solid rgba(179,157,106,.2)}.auth-column{position:relative;width:min(100%,620px);margin:0 auto}.form-heading{margin:0 0 18px;color:#e8dfcc;font-family:'Cinzel',Georgia,serif;font-weight:500;letter-spacing:.025em;font-size:14px}.auth-form{display:flex;flex-direction:column;gap:17px}.form-field{display:flex;flex-direction:column;gap:7px}.form-field label{display:block;color:#e3d7bb;font-family:'Cinzel',Georgia,serif;font-size:14px;font-weight:600;letter-spacing:.045em}.form-input{display:block;width:100%;height:54px;padding:0 16px;border:1px solid #716c59;background:#0a1311;color:#f4efe9;font-family:'EB Garamond',Georgia,serif;font-size:18px;box-shadow:inset 0 3px 8px rgba(0,0,0,.46),inset 0 1px rgba(255,255,255,.04);outline:none}.form-input::placeholder{color:#adb0a4;font-style:italic;opacity:1}.form-input:focus{border-color:#d0b777;box-shadow:inset 0 3px 8px rgba(0,0,0,.46),0 0 0 2px rgba(199,166,108,.23)}.password-head{display:flex;align-items:center;justify-content:space-between;gap:16px}.password-help{flex:none;color:#d9bc7d;text-decoration:underline;text-decoration-color:rgba(217,188,125,.52);text-underline-offset:3px;font-size:15px;line-height:1.3}.submit-button{width:100%;min-height:78px;display:flex;align-items:center;justify-content:center;gap:20px;margin-top:5px;padding:7px 18px;background:linear-gradient(180deg,#e0c78e 0%,#c9aa6c 48%,#ad8b50 100%);border:2px solid #786342;color:#18150f;font-family:'Cinzel',Georgia,serif;font-size:17px;line-height:1.2;letter-spacing:.09em;font-weight:700;text-transform:uppercase;box-shadow:inset 0 1px rgba(255,246,207,.66),inset 0 -2px rgba(81,57,26,.2);cursor:default}.phoenix-medallion{width:66px;height:66px;flex:none;display:block;border:2px solid #71603d;border-radius:50%;object-fit:cover;box-shadow:0 1px 0 rgba(255,239,185,.5),0 2px 4px rgba(0,0,0,.45)}.submit-label{display:block;text-align:left}.switch-prompt{margin:18px 0 12px;text-align:center;color:#c4c4b7;font-size:16px;line-height:1.35}.switch-prompt strong{color:#ead59e;font-weight:600;text-decoration:underline;text-underline-offset:3px}.supabase-note{padding:11px 14px;border-top:1px solid rgba(198,171,111,.42);border-bottom:1px solid rgba(198,171,111,.26);color:#c4c2b4;font-size:14px;line-height:1.45}.supabase-note strong{color:#e0c481;font-family:'Cinzel',Georgia,serif;font-size:13px;font-weight:600;letter-spacing:.055em}.threshold-sill{position:relative;min-height:74px;display:flex;align-items:center;justify-content:center;padding:9px 22px;background:linear-gradient(180deg,#4a4b40,#242b26 34%,#171f1b 100%);border:2px solid #625a46;border-top:4px solid #776342;box-shadow:inset 0 1px rgba(245,225,175,.15),0 7px 0 rgba(5,11,9,.7)}.glyph-row{display:flex;align-items:center;justify-content:center;gap:clamp(27px,6vw,82px);color:#b99c61}.glyph{width:34px;height:34px;display:flex;align-items:center;justify-content:center;color:#ba9f69;font-size:25px;filter:drop-shadow(0 1px 1px #090e0c)}.glyph i{font-size:25px;line-height:1}.glyph-phoenix{width:31px;height:31px;border-radius:50%;object-fit:cover;filter:sepia(.18) saturate(.7) brightness(.82)}.scene-caption{position:absolute;right:0;bottom:-28px;color:rgba(227,222,203,.68);font-size:12px;letter-spacing:.02em}@media(max-width:760px){.gatehouse-page{padding:24px 12px;align-items:flex-start}.gatehouse-shell{margin:auto}.lintel{padding:16px 20px;min-height:117px}.gatehouse-body{grid-template-columns:34px minmax(0,1fr) 34px}.stone-pier{min-height:530px;border-inline-width:2px}.pier-cap{height:18px}.pier-blocks{inset-inline:3px}.pier-stud{width:7px;height:7px}.writing-surface{padding:24px 23px 18px}.stone-tabs{padding-inline:7px}.stone-tab{font-size:13px;letter-spacing:.09em}.scene-caption{right:8px}}@media(max-width:520px){.gatehouse-page{padding:14px 8px 26px}.lintel{min-height:106px;padding:13px 15px}.lintel-title{font-size:13px;letter-spacing:.11em}.brand-row{gap:9px}.brand-crest{width:38px;height:41px}.brand-subtitle{font-size:13px}.gatehouse-body{grid-template-columns:11px minmax(0,1fr) 11px}.stone-pier{min-height:540px;border-inline-width:1px}.stone-pier:before,.stone-pier:after,.pier-blocks,.pier-stud{display:none}.stone-tabs{padding:7px 4px 0;gap:3px}.stone-tab{min-height:48px;font-size:12px;letter-spacing:.06em}.writing-surface{padding:22px 14px 16px;min-height:480px}.writing-surface:before{inset:7px 5px}.form-heading{font-size:13px;margin-bottom:14px}.auth-form{gap:15px}.form-field label{font-size:12px}.form-input{height:51px;padding-inline:12px;font-size:17px}.password-head{align-items:flex-start;flex-direction:column;gap:5px}.password-help{font-size:14px}.submit-button{min-height:72px;gap:12px;padding:6px 12px;font-size:14px;letter-spacing:.06em}.phoenix-medallion{width:58px;height:58px}.switch-prompt{margin:15px 0 11px;font-size:15px}.supabase-note{padding:9px 10px;font-size:13px}.supabase-note strong{font-size:12px}.threshold-sill{min-height:64px;padding:8px 10px}.glyph-row{gap:clamp(18px,8vw,38px)}.glyph,.glyph i{font-size:21px}.glyph-phoenix{width:27px;height:27px}.scene-caption{display:none}}\n</style>\n<div class=\"gatehouse-page\" data-kid=\"1\">\n    <img alt=\"Ruínas de pedra entre uma floresta densa e úmida — fotografia de Maik Astheimer no Unsplash.\" class=\"forest-backdrop\" data-kid=\"1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1786712308232-5be9fc460622?auto=format&w=1800&q=80&fit=crop\"/>\n    <div aria-hidden=\"true\" class=\"forest-shade\" data-kid=\"1-2\">\n    </div>\n    <main aria-label=\"Portal de autenticação Elementum\" class=\"gatehouse-shell\" data-kid=\"1-3\">\n        <header class=\"lintel\" data-kid=\"1-3-1\">\n            <div class=\"lintel-content\" data-kid=\"1-3-1-1\">\n                <h1 class=\"lintel-title\" data-kid=\"1-3-1-1-1\">\n                    PORTAL DOS AVENTUREIROS\n                </h1>\n                <div class=\"brand-row\" data-kid=\"1-3-1-1-2\">\n                    <svg aria-hidden=\"true\" class=\"brand-crest\" data-kid=\"1-3-1-1-2-1\" fill=\"none\" viewbox=\"0 0 48 52\">\n                        <path d=\"M24 2 44 9v14c0 14-8 22-20 27C12 45 4 37 4 23V9z\" fill=\"rgba(11,19,18,.9)\" stroke=\"rgba(240,219,162,.9)\" stroke-width=\"1.8\">\n                        </path>\n                        <path d=\"M24 10v32M14 18h20M15 30h18\" stroke=\"rgba(240,219,162,.9)\" stroke-linecap=\"round\" stroke-width=\"1.5\">\n                        </path>\n                        <circle cx=\"24\" cy=\"18\" fill=\"rgba(240,219,162,.95)\" r=\"2.5\">\n                        </circle>\n                    </svg>\n                    <p class=\"brand-subtitle\" data-kid=\"1-3-1-1-2-2\">\n                        ELEMENTUM\n                        <span aria-hidden=\"true\" data-kid=\"1-3-1-1-2-2-1\">\n                            —\n                        </span>\n                        As crónicas começam aqui\n                    </p>\n                </div>\n            </div>\n        </header>\n        <section aria-label=\"Entrada do portal\" class=\"gatehouse-body\" data-kid=\"1-3-2\">\n            <aside aria-hidden=\"true\" class=\"stone-pier\" data-kid=\"1-3-2-1\">\n                <div class=\"pier-cap\" data-kid=\"1-3-2-1-1\">\n                </div>\n                <div class=\"pier-blocks\" data-kid=\"1-3-2-1-2\">\n                    <span class=\"pier-joint\" data-kid=\"1-3-2-1-2-1\">\n                    </span>\n                    <span class=\"pier-joint\" data-kid=\"1-3-2-1-2-2\">\n                    </span>\n                    <span class=\"pier-joint\" data-kid=\"1-3-2-1-2-3\">\n                    </span>\n                    <span class=\"pier-joint\" data-kid=\"1-3-2-1-2-4\">\n                    </span>\n                </div>\n                <span class=\"pier-stud top\" data-kid=\"1-3-2-1-3\">\n                </span>\n                <span class=\"pier-stud bottom\" data-kid=\"1-3-2-1-4\">\n                </span>\n            </aside>\n            <div class=\"gatehouse-opening\" data-kid=\"1-3-2-2\">\n                <div aria-label=\"Acesso à conta\" class=\"stone-tabs\" data-kid=\"1-3-2-2-1\" role=\"tablist\">\n                    <button aria-selected=\"true\" class=\"stone-tab is-active\" data-kid=\"1-3-2-2-1-1\" role=\"tab\" type=\"button\">\n                        ENTRAR\n                    </button>\n                    <button aria-selected=\"false\" class=\"stone-tab\" data-kid=\"1-3-2-2-1-2\" role=\"tab\" type=\"button\">\n                        CRIAR CONTA\n                    </button>\n                </div>\n                <section aria-label=\"Entrar na conta\" class=\"writing-surface\" data-kid=\"1-3-2-2-2\">\n                    <div class=\"auth-column\" data-kid=\"1-3-2-2-2-1\">\n                        <form class=\"auth-form\" data-kid=\"1-3-2-2-2-1-2\">\n                            <div class=\"form-field\" data-kid=\"1-3-2-2-2-1-2-1\">\n                                <label data-kid=\"1-3-2-2-2-1-2-1-1\" for=\"gatehouse-email\">\n                                    E-mail do Reino\n                                </label>\n                                <input autocomplete=\"email\" class=\"form-input\" data-kid=\"1-3-2-2-2-1-2-1-2\" id=\"gatehouse-email\" placeholder=\"seu-email@reino.com\" type=\"email\"/>\n                            </div>\n                            <div class=\"form-field\" data-kid=\"1-3-2-2-2-1-2-2\">\n                                <div class=\"password-head\" data-kid=\"1-3-2-2-2-1-2-2-1\">\n                                    <label data-kid=\"1-3-2-2-2-1-2-2-1-1\" for=\"gatehouse-password\">\n                                        Senha Arcana\n                                    </label>\n                                    <span aria-disabled=\"true\" class=\"password-help\" data-kid=\"1-3-2-2-2-1-2-2-1-2\" role=\"link\">\n                                        Esqueceu sua senha?\n                                    </span>\n                                </div>\n                                <input autocomplete=\"current-password\" class=\"form-input\" data-kid=\"1-3-2-2-2-1-2-2-2\" id=\"gatehouse-password\" placeholder=\"Sua senha secreta\" type=\"password\"/>\n                            </div>\n                            <button class=\"submit-button\" data-kid=\"1-3-2-2-2-1-2-3\" type=\"button\">\n                                <img alt=\"Medalhão de fênix em ferro forjado e ouro antigo\" class=\"phoenix-medallion\" data-kid=\"1-3-2-2-2-1-2-3-1\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/0087bbb4-ab33-4bd5-97ed-3ecab494db32/6121d9f3a402447e99deac3b71d8fd39.jpg\"/>\n                                <span class=\"submit-label\" data-kid=\"1-3-2-2-2-1-2-3-2\">\n                                    Adentrar ao Reino\n                                </span>\n                            </button>\n                        </form>\n                        <p class=\"switch-prompt\" data-kid=\"1-3-2-2-2-1-3\">\n                            Novo nestas terras?\n                            <strong data-kid=\"1-3-2-2-2-1-3-1\">\n                                Forjar uma nova conta\n                            </strong>\n                        </p>\n                        <p class=\"supabase-note\" data-kid=\"1-3-2-2-2-1-4\">\n                            <strong data-kid=\"1-3-2-2-2-1-4-1\">\n                                CONECTADO AO SUPABASE:\n                            </strong>\n                            As contas criadas são salvas e sincronizadas diretamente no seu projeto Supabase.\n                        </p>\n                    </div>\n                </section>\n            </div>\n            <aside aria-hidden=\"true\" class=\"stone-pier\" data-kid=\"1-3-2-3\">\n                <div class=\"pier-cap\" data-kid=\"1-3-2-3-1\">\n                </div>\n                <div class=\"pier-blocks\" data-kid=\"1-3-2-3-2\">\n                    <span class=\"pier-joint\" data-kid=\"1-3-2-3-2-1\">\n                    </span>\n                    <span class=\"pier-joint\" data-kid=\"1-3-2-3-2-2\">\n                    </span>\n                    <span class=\"pier-joint\" data-kid=\"1-3-2-3-2-3\">\n                    </span>\n                    <span class=\"pier-joint\" data-kid=\"1-3-2-3-2-4\">\n                    </span>\n                </div>\n                <span class=\"pier-stud top\" data-kid=\"1-3-2-3-3\">\n                </span>\n                <span class=\"pier-stud bottom\" data-kid=\"1-3-2-3-4\">\n                </span>\n            </aside>\n        </section>\n        <footer aria-label=\"Glifos forjados de Elementum\" class=\"threshold-sill\" data-kid=\"1-3-3\">\n            <div aria-hidden=\"true\" class=\"glyph-row\" data-kid=\"1-3-3-1\">\n                <span class=\"glyph\" data-kid=\"1-3-3-1-1\">\n                    <i class=\"ti ti-shield\" data-kid=\"1-3-3-1-1-1\">\n                    </i>\n                </span>\n                <span class=\"glyph\" data-kid=\"1-3-3-1-2\" data-name=\"pouch glyph container\">\n                    <i class=\"ti ti-moneybag\" data-kid=\"1-3-3-1-2-1\" data-name=\"coin pouch glyph icon\">\n                    </i>\n                </span>\n                <span class=\"glyph\" data-kid=\"1-3-3-1-3\">\n                    <img alt=\"\" class=\"glyph-phoenix\" data-kid=\"1-3-3-1-3-1\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/0087bbb4-ab33-4bd5-97ed-3ecab494db32/6121d9f3a402447e99deac3b71d8fd39.jpg\"/>\n                </span>\n                <span class=\"glyph\" data-kid=\"1-3-3-1-4\">\n                    <i class=\"ti ti-swords\" data-kid=\"1-3-3-1-4-1\">\n                    </i>\n                </span>\n                <span class=\"glyph\" data-kid=\"1-3-3-1-5\">\n                    <i class=\"ti ti-star\" data-kid=\"1-3-3-1-5-1\">\n                    </i>\n                </span>\n            </div>\n        </footer>\n    </main>\n</div>\n",
